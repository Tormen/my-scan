# Run an AppleScript with a bound on it, reading the script from stdin and
# leaving its combined output in $OSA_OUT. Returns 0 on success, 1 on a script
# error, 2 when it had to be killed for overrunning OSASCRIPT_TIMEOUT.
#
# The timeout is the point: the FIRST System Events call from a new terminal
# makes macOS raise the Automation consent dialog, and osascript waits on that
# answer indefinitely. Over ssh, or from a LaunchDaemon, there is no GUI
# session to show it in and the wait never ends.
osa_run() {
  OSA_OUT=""
  _osa_scr="$(mktemp /tmp/my-scan.osa.XXXXXX)"   || return 1
  _osa_res="$(mktemp /tmp/my-scan.osaout.XXXXXX)" || { rm -f "$_osa_scr"; return 1; }
  cat >"$_osa_scr"
  /usr/bin/osascript "$_osa_scr" >"$_osa_res" 2>&1 &
  _osa_pid=$!
  _osa_max="$OSASCRIPT_TIMEOUT"
  isInt "$_osa_max" || _osa_max=180
  _osa_w=0
  while kill -0 "$_osa_pid" 2>/dev/null; do
    [ "$_osa_w" -ge "$_osa_max" ] && break
    sleep 1
    _osa_w=$(( _osa_w + 1 ))
  done
  if kill -0 "$_osa_pid" 2>/dev/null; then
    kill -9 "$_osa_pid" 2>/dev/null
    OSA_OUT="osascript did not answer within ${_osa_max}s"
    rm -f "$_osa_scr" "$_osa_res"
    return 2
  fi
  wait "$_osa_pid" 2>/dev/null
  _osa_rc=$?
  OSA_OUT="$(cat "$_osa_res")"
  rm -f "$_osa_scr" "$_osa_res"
  [ "$_osa_rc" -eq 0 ] || return 1
  return 0
}

# Can a consent dialog actually be answered from here? Automation permission is
# granted per CALLING application, and the prompt is drawn in the console user's
# GUI session. From ssh there is nobody to click it.
osa_can_prompt() {
  [ -n "$SSH_CONNECTION$SSH_TTY$SSH_CLIENT" ] && return 1
  [ "$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)" = "$(id -un)" ] || return 1
  return 0
}

# Resolve a directory to its physical path. System Events stores the RESOLVED
# path of a folder action, so a config that names a symlinked drop folder never
# string-matches what comes back -- compare the resolved paths, not the names.
canon_dir() {
  ( cd "$1" 2>/dev/null && pwd -P ) 2>/dev/null || printf '%s\n' "$1"
}

# Read the bindings back from System Events and say, in the words the user
# will see, what Folder Actions Setup should now show. Attaching without
# confirming is how a setup silently half-works.
setup_verify_bindings() {
  osa_run <<'_EOSV_' || return 1
tell application "System Events"
	set out to ""
	try
		if folder actions enabled then set out to out & "enabled" & linefeed
	end try
	set fas to {}
	try
		set fas to folder actions
	end try
	-- Each folder action is guarded ON ITS OWN. A single try around the whole
	-- loop makes one bad entry end the enumeration and return a PARTIAL list
	-- that looks complete -- the binding you just made is simply absent.
	repeat with fa in fas
		set fn to ""
		try
			set fn to POSIX path of (path of fa)
		end try
		if fn is "" then
			try
				set fn to (path of fa) as text
			end try
		end if
		if fn is "" then
			try
				set fn to (name of fa) as text
			end try
		end if
		if fn is "" then set fn to "-"
		set fe to "-"
		try
			set fe to (enabled of fa) as text
		end try
		set scs to {}
		set serr to ""
		try
			set scs to scripts of fa
		on error em
			set serr to em
		end try
		if serr is not "" then
			set out to out & fn & tab & "<scripts unreadable: " & serr & ">" & tab & fe & linefeed
		else if (count of scs) is 0 then
			set out to out & fn & tab & "<no scripts attached>" & tab & fe & linefeed
		else
			repeat with sc in scs
				set sn to "-"
				try
					set sn to (name of sc) as text
				end try
				set out to out & fn & tab & sn & tab & fe & linefeed
			end repeat
		end if
	end repeat
	return out
end tell
_EOSV_
  printf '%s' "$OSA_OUT"
}

setup_attach() {
  msg2 "Folder Action bindings"
  for _dp in $DROP_PATHS; do
    if [ -n "$DRY_RUN" ]; then
      det "WOULD ATTACH '$WORKFLOW_NAME' to '$_dp'"
      continue
    fi
    vrb "osascript -e 'tell application \"System Events\" ... attach $WORKFLOW_NAME to $_dp'"
    vdet "System Events owns the folder<->workflow bindings and mints the"
    vdet "security-scoped bookmarks itself; the preferences plist cannot be"
    vdet "written by hand, so this is the only way to automate it"
    # Say this BEFORE the call, not after: once osascript blocks on the consent
    # dialog there is no output at all, and the dialog is on a screen the
    # caller may not be looking at.
    if ! osa_can_prompt; then
      det "NOTE: macOS may now ask '...wants access to control System Events'"
      det "      ON THE CONSOLE of $(hostname -s) -- go there and click Allow."
      det "      (you are not at that console: $( [ -n "$SSH_CONNECTION$SSH_TTY$SSH_CLIENT" ] && echo "this is an ssh session" || echo "console user is $(/usr/bin/stat -f%Su /dev/console 2>/dev/null)" ))"
    fi
    osa_run <<_EOAS_
tell application "System Events"
	set folder actions enabled to true
	set p to POSIX file "$_dp" as alias
	try
		set fa to folder action (name of (info for p))
	on error
		set fa to make new folder action at end of folder actions with properties {path:"$_dp"}
	end try
	tell fa
		set enabled to true
		try
			get script "$WORKFLOW_NAME"
		on error
			make new script at end of scripts with properties {name:"$WORKFLOW_NAME"}
		end try
	end tell
end tell
_EOAS_
    _ast=$?
    if [ "$_ast" -eq 0 ]; then
      det "attached '$WORKFLOW_NAME' to '$_dp' [0]"
    elif [ "$_ast" -eq 2 ]; then
      det "TIMED OUT: $OSA_OUT"
      det "That almost always means the Automation consent dialog is waiting on"
      det "the CONSOLE of $(hostname -s) -- '...wants access to control System"
      det "Events'. Click Allow there, then re-run '$US setup go'."
      det "Or do it by hand: right-click '$_dp' -> Services -> Folder Actions Setup."
    else
      det "COULD NOT attach automatically: $OSA_OUT"
      det "macOS gates this behind Automation permission for the calling app:"
      det "System Settings -> Privacy & Security -> Automation -> your terminal"
      det "-> allow 'System Events'. Then re-run '$US setup go'."
      det "Or do it by hand: right-click '$_dp' -> Services -> Folder Actions Setup."
    fi
  done

  # Confirm, and tell them what they should SEE -- an attach that reports
  # success but did not stick is worse than one that admits it failed.
  [ -n "$DRY_RUN" ] && return 0
  _bind="$(setup_verify_bindings)"
  if [ -z "$_bind" ]; then
    det "could not read the bindings back -- check Folder Actions Setup by hand"
    return 0
  fi
  # Another script on OUR folder is not an error -- a second workflow can be
  # deliberate -- but every attached script fires for every new file, so say so.
  _ws_foreign="$(mktemp /tmp/my-scan.foreign.XXXXXX)" || _ws_foreign=""

  echo
  msg2 "In Finder: right-click a folder -> Services -> Folder Actions Setup..."
  det "Folder Actions is $( printf '%s\n' "$_bind" | grep -q '^enabled' && echo ON || echo 'OFF -- switch it on!' )"
  det "and you should see these folder / script pairs:"
  # '%s\n', not '%s': the command substitution above stripped the trailing
  # newline, and POSIX 'read' returns non-zero at EOF even when it read a
  # partial line -- so 'while read' would silently drop the LAST binding.
  printf '%s\n' "$_bind" | while IFS="$TAB" read -r _bf _bs _be; do
    [ -z "$_bf" ] && continue
    case "$_bf" in enabled) continue;; esac
    _mark="  "
    _shown="$_bf"
    _stored=""
    if [ "$_bf" != "-" ]; then
      _bfc="$(canon_dir "$_bf")"
      for _dp in $DROP_PATHS; do
        [ "$(canon_dir "$_dp")" = "$_bfc" ] || continue
        [ "$_bs" = "$WORKFLOW_NAME" ] || continue
        _mark="->"
        # show the path the CONFIG names -- that is the one the reader knows --
        # but keep what System Events actually stored beside it when they differ
        _shown="$_dp"
        [ "${_dp%/}" = "${_bf%/}" ] || _stored="$_bf"
      done
    fi
    if [ -n "$_stored" ]; then
      _p "    $_mark $_shown  (stored as $_stored)"
    else
      _p "    $_mark $_shown"
    fi
    _p "         $_bs  (folder action enabled: $_be)"
    # a script on one of OUR folders that is not OURS
    if [ "$_bf" != "-" ] && [ "$_bs" != "$WORKFLOW_NAME" ] && [ -n "$_ws_foreign" ]; then
      _bfc2="$(canon_dir "$_bf")"
      for _dp in $DROP_PATHS; do
        [ "$(canon_dir "$_dp")" = "$_bfc2" ] && printf '%s\t%s\n' "$_bs" "$_shown" >> "$_ws_foreign"
      done
    fi
  done
  det "'->' marks the ones $US just set up; anything else is another tool's"
  det "(my-ocr keeps its own on ~/Public/,ocr.in and $US never touches it)."

  if [ -n "$_ws_foreign" ] && [ -s "$_ws_foreign" ]; then
    echo
    msg2 "WARNING -- another script also runs on a folder $US watches:"
    while IFS="$TAB" read -r _fs _ff; do
      [ -n "$_fs" ] && det "$_fs   on '$_ff'"
    done < "$_ws_foreign"
    det "macOS fires EVERY attached script for each new file, so each document"
    det "is processed more than once. Intended? Leave it. Otherwise: detach it in"
    det "Folder Actions Setup -- select the folder, select the script, click '-'."
  fi
  rm -f "$_ws_foreign"
  return 0
}

# The inverse of setup: take the wiring OUT. It removes ONLY what setup put in
# -- our own script, and the workflow setup generated. Another tool's script on
# the same folder is left alone, and so is the folder action itself while that
# script still needs it. It never touches a document, a queue or a drop folder:
# uninstalling the trigger must never be able to lose a scan.
do_uninstall() {
  if [ "$1" = "go" ]; then DRY_RUN=""; else DRY_RUN=1; fi

  _gui="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
  if [ "$(id -u)" = "0" ]; then
    err 081 "Run '$US uninstall' as the GUI user, not as root.
The Folder Action belongs to the caller's login session; as root you would be
detaching root's, not '${_gui:-the console user}'s.
Try:   su - ${_gui:-<the console user>} -c '$US uninstall${1:+ $1}'"
  fi

  if [ -n "$DRY_RUN" ]; then
    msg "UNINSTALL -- DRY RUN. Nothing is changed. Apply with: $US uninstall go"
  else
    msg "UNINSTALL -- removing the wiring, for GUI user '$(id -un)' on $(hostname -s)"
  fi
  det "config: $CONFIG_FILE"
  det "documents, queues and drop folders are never touched"

  # 1. detach our script from each drop folder
  msg2 "Folder Action bindings"
  for _dp in $DROP_PATHS; do
    if [ -n "$DRY_RUN" ]; then
      det "WOULD DETACH '$WORKFLOW_NAME' from '$_dp'"
      continue
    fi
    osa_run <<_EOUN_
tell application "System Events"
	set p to POSIX file "$_dp" as alias
	try
		set fa to folder action (name of (info for p))
		tell fa
			try
				delete script "$WORKFLOW_NAME"
			end try
		end tell
		-- drop the folder action itself only when nothing else needs it
		if (count of scripts of fa) is 0 then delete fa
	end try
end tell
_EOUN_
    _ust=$?
    if [ "$_ust" -eq 0 ]; then
      det "detached '$WORKFLOW_NAME' from '$_dp' [0]"
    elif [ "$_ust" -eq 2 ]; then
      det "TIMED OUT: $OSA_OUT"
      det "a consent dialog may be waiting on the console of $(hostname -s)."
    else
      det "COULD NOT detach automatically: $OSA_OUT"
      det "Do it by hand: right-click '$_dp' -> Services -> Folder Actions Setup."
    fi
  done

  # 2. remove the workflow setup generated, and its backups
  _uwf="$WORKFLOW_DIR/$WORKFLOW_NAME"
  msg2 "Automator workflow '$_uwf'"
  if [ ! -d "$_uwf" ]; then
    det "not present -- nothing to remove"
  elif [ -n "$DRY_RUN" ]; then
    det "WOULD REMOVE it (to the Trash, so it stays recoverable)"
  elif [ -x "$c_trash" ]; then
    if "$c_trash" "$_uwf" >/dev/null 2>&1; then det "moved to the Trash [0]"
    else det "COULD NOT trash it -- remove '$_uwf' by hand"; fi
  else
    det "'$c_trash' not available -- remove '$_uwf' by hand (not deleting it here)"
  fi
  if [ -z "$DRY_RUN" ] && [ -x "$c_trash" ]; then
    find "$WORKFLOW_DIR" -maxdepth 1 -type d -name "$WORKFLOW_NAME.bak-*" 2>/dev/null \
      | while IFS= read -r _ub; do
          [ -n "$_ub" ] && "$c_trash" "$_ub" >/dev/null 2>&1 \
            && det "trashed backup '${_ub##*/}'"
        done
  fi

  echo
  if [ -n "$DRY_RUN" ]; then
    det "this was a dry run -- apply it with:  $US uninstall go"
  else
    det "done. '$US setup go' puts it back."
  fi
  return 0
}

do_setup() {
  if [ "$1" = "go" ]; then DRY_RUN=""; else DRY_RUN=1; fi

  # setup writes into $HOME and binds the Folder Action through System Events
  # in the CALLER'S login session. As root both of those are root's: the
  # workflow lands in /var/root/Library/... where you will never see it, and
  # the binding attaches to a session no scan ever arrives in. It would look
  # like it worked -- it even used to print "for GUI user 'root'".
  _gui="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
  if [ "$(id -u)" = "0" ]; then
    err 080 "Run '$US setup' as the GUI user, not as root.
It writes into \$HOME (here: '$HOME') and binds the Folder Action in the
caller's login session -- as root, both would be root's and no scan would
ever reach it.
Try:   su - ${_gui:-<the console user>} -c '$US setup${1:+ $1}'"
  fi
  if [ -n "$_gui" ] && [ "$_gui" != "$(id -un)" ]; then
    err 081 "You are '$(id -un)' but the console (GUI) user is '$_gui'.
The Folder Action has to belong to the user whose session the scans arrive in,
so this would set it up for the wrong account." "-"
    det "continuing anyway -- but check the bindings it reports at the end"
  fi

  if [ -n "$DRY_RUN" ]; then
    msg "SETUP -- DRY RUN. Nothing is changed. Re-run as '$US setup go' to apply."
  else
    msg "SETUP -- applying, for GUI user '$(id -un)' on $(hostname -s)"
  fi
  det "config: $CONFIG_FILE"

  setup_preflight;       _pf=$?
  setup_dirs;            _sd=$?
  setup_write_workflow;  _sw=$?
  setup_attach

  echo
  if [ "$_pf" -eq 0 ] && [ "$_sd" -eq 0 ] && [ "$_sw" -eq 0 ]; then
    msg "setup OK [0]"
  else
    msg "setup INCOMPLETE (preflight [$_pf], dirs [$_sd], workflow [$_sw])"
    det "fix the items marked MISSING / NOT WRITABLE above, then re-run"
  fi

  if [ -n "$DRY_RUN" ]; then
    echo
    det "this was a dry run -- apply it with:  $US setup go"
  fi

  echo
  do_status ""
  return 0
}







##############################################################################
#### --run-tests
# Every stage the pipeline actually has, exercised for real against temp dirs
# and a STUB my-ocr -- no FineReader, no GUI, seconds not minutes. The stub is
# what makes stage 4 testable at all: the real one needs a single-instance app.

T_PASS=0; T_FAIL=0
t_ok()  { T_PASS=$(( T_PASS + 1 )); printf '  ok    %s\n' "$1"; }
t_bad() { T_FAIL=$(( T_FAIL + 1 )); printf '  FAIL  %s\n' "$1"
          [ -n "$2" ] && printf '        %s\n' "$2"; return 0; }

# A throw-away pipeline: drop/queue/done/failed dirs, a config, a stub my-ocr.
t_world() { # $1 = dir; sets T_CONF
  _tw="$1"
  mkdir -p "$_tw/drop" "$_tw/2ocr" "$_tw/done" "$_tw/failed" "$_tw/wf"
  # stub my-ocr: renames each file in place the way the real one does, and
  # records what it was handed so the batching contract can be checked.
  # The stub honours the REAL contract: my-ocr OCRs in place and moves whatever
  # it could not do to --move-failed-to. my-scan files what is left; it reads no
  # exit status and parses no output, so the stub must behave the same way.
  cat >"$_tw/my-ocr.stub" <<'_EOSTUB_'
#!/bin/dash
_d="$(dirname "$0")"
: >"$_d/ocr.called"
_failto=""
_rc=0
while [ $# -gt 0 ]; do
  case "$1" in
    --move-failed-to) _failto="$2"; shift 2; continue ;;
    -*) shift; continue ;;
  esac
  _f="$1"; shift
  [ -f "$_f" ] || continue
  printf '%s\n' "$_f" >>"$_d/ocr.args"
  case "$_f" in
    *BOOM*)                              # a file the OCR cannot handle
      _rc=1
      [ -n "$_failto" ] && { mkdir -p "$_failto"; mv "$_f" "$_failto/"; } ;;
    *) printf 'OCRED\n' >>"$_f" ;;       # in place, like the real my-ocr
  esac
done
exit $_rc
_EOSTUB_
  chmod +x "$_tw/my-ocr.stub"
  T_CONF="$_tw/conf"
  T_WFDIR="$_tw/wf"
  # trash lives in a different place per machine; the suite must not depend on
  # one path being right, or it fails for reasons that are not about my-scan.
  # The helper tools sit in a different place on every machine (brew prefix,
  # /usr/bin, /LINKS/bin). Resolve each from PATH so the suite tests my-scan,
  # not this machine's layout.
  # a sed SCRIPT file, not a built-up argument string: quoting a list of -e
  # arguments through a variable does not survive word splitting intact.
  _tsedf="$_tw/toolpaths.sed"
  : >"$_tsedf"
  for _tk in trash convert identify pdfinfo lsof qpdf; do
    _tv="$(command -v "$_tk" 2>/dev/null)"
    [ -z "$_tv" ] && [ -x "/LINKS/bin/$_tk" ] && _tv="/LINKS/bin/$_tk"
    [ -n "$_tv" ] && printf 's|^c_%s=.*|c_%s="%s"|\n' "$_tk" "$_tk" "$_tv" >>"$_tsedf"
  done
  "$0" --create-config 2>/dev/null | sed -f "$_tsedf" \
    | sed -e "s|^DROP_PATHS=.*|DROP_PATHS=\"$_tw/drop\"|" \
          -e "s|^OCR_QUEUE_PATH=.*|OCR_QUEUE_PATH=\"$_tw/2ocr\"|" \
          -e "s|^T_PATH_DONE=.*|T_PATH_DONE=\"$_tw/done\"|" \
          -e "s|^T_PATH_FAILED=.*|T_PATH_FAILED=\"$_tw/failed\"|" \
          -e "s|^WORKFLOW_DIR=.*|WORKFLOW_DIR=\"$_tw/wf\"|" \
          -e "s|^MY_OCR=.*|MY_OCR=\"$_tw/my-ocr.stub\"|" \
          -e "s|^SCAN_DEVICE=.*|SCAN_DEVICE=\"\"|" \
          -e "s|^LOG=.*|LOG=\"\"|" \
          -e "s|^SETTLE_TIMEOUT=.*|SETTLE_TIMEOUT=20|" \
          -e "s|^SETTLE_STABLE_POLLS=.*|SETTLE_STABLE_POLLS=2|" \
          >"$T_CONF"
}

# A PDF that really parses -- settle's third check runs pdfinfo, and a
# hand-waved "%PDF" header does NOT satisfy it (it needs a valid xref).
t_pdf() {
  /usr/bin/python3 - "$1" <<'_EOPDF_'
import sys
objs = [b"<< /Type /Catalog /Pages 2 0 R >>",
        b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
        b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] >>"]
out = b"%PDF-1.4\n"; offs = []
for i, o in enumerate(objs, 1):
    offs.append(len(out)); out += b"%d 0 obj\n" % i + o + b"\nendobj\n"
x = len(out)
out += b"xref\n0 %d\n" % (len(objs) + 1) + b"0000000000 65535 f \n"
for o in offs:
    out += b"%010d 00000 n \n" % o
out += b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (len(objs) + 1, x)
open(sys.argv[1], "wb").write(out)
_EOPDF_
}

# ---- STAGE 1: input collection -------------------------------------------
t_stage_inputs() {
  _d="$T_TMP/inputs"; t_world "$_d"
  t_pdf "$_d/drop/a.pdf"; t_pdf "$_d/drop/b.pdf"
  _o="$("$0" --config "$T_CONF" process 2>&1 </dev/null)"
  case "$_o" in
    *a.pdf*b.pdf*|*b.pdf*a.pdf*) t_ok "stage 1: bare 'process' LISTS pending, changes nothing";;
    *) t_bad "stage 1: bare 'process' LISTS pending, changes nothing" "$(printf '%s' "$_o" | head -2)";;
  esac
  if [ -f "$_d/drop/a.pdf" ] && [ ! -f "$_d/my-ocr.stub.called" ]; then
    t_ok "stage 1: listing does not touch the files"
  else
    t_bad "stage 1: listing does not touch the files" "a listing must never process"
  fi
  # oldest first -- the order they were scanned in
  _p="$("$0" --config "$T_CONF" process 2>&1 </dev/null | grep -c 'pdf')"
  if [ "$_p" -ge 2 ]; then
    t_ok "stage 1: both pending files are listed"
  else
    t_bad "stage 1: both pending files are listed" "got $_p"
  fi
}

# ---- STAGE 2: settle ------------------------------------------------------
t_stage_settle() {
  _d="$T_TMP/settle"; t_world "$_d"
  # (a) a file that does not parse never settles
  printf 'not a pdf' >"$_d/drop/junk.pdf"
  _o="$("$0" --config "$T_CONF" --settle-timeout 3 process --all 2>&1 </dev/null)"
  case "$_o" in
    *"does not parse"*|*"not settle"*|*settle*) t_ok "stage 2: an unparseable delivery is not staged";;
    *) t_bad "stage 2: an unparseable delivery is not staged" "$(printf '%s' "$_o" | tail -2)";;
  esac
  # ...and it is quarantined rather than left to be retried for ever
  if [ -n "$(find "$_d/failed" -type f 2>/dev/null)" ]; then
    t_ok "stage 2: it is quarantined under FAILED, not silently dropped"
  elif [ -f "$_d/drop/junk.pdf" ]; then
    t_ok "stage 2: it is left in the drop folder"
  else
    t_bad "stage 2: it is quarantined under FAILED, not silently dropped" "it vanished entirely"
  fi
  # (b) status -V explains WHICH of the three checks is failing
  _o="$("$0" --config "$T_CONF" -V status 2>&1 </dev/null)"
  case "$_o" in
    *parse*|*writer*|*growing*|*settle*) t_ok "stage 2: 'status -V' diagnoses the stuck file";;
    *) t_bad "stage 2: 'status -V' diagnoses the stuck file" "no settle reason in -V output";;
  esac
}

# ---- STAGE 3: staging (name + move) ---------------------------------------
t_stage_staging() {
  _d="$T_TMP/staging"; t_world "$_d"
  t_pdf "$_d/drop/scan001.pdf"
  "$0" --config "$T_CONF" process --all >/dev/null 2>&1 </dev/null
  _f="$(find "$_d/done" -name '*.pdf' -type f 2>/dev/null | head -n 1)"
  if [ -n "$_f" ]; then t_ok "stage 3+5: the delivery is staged, OCRed and filed"
  else t_bad "stage 3+5: the delivery is staged, OCRed and filed" "nothing in done/"; return 0; fi
  case "${_f##*/}" in
    [12][0-9][0-9][0-9]-[01][0-9]-[0-3][0-9]_*___scan001.pdf)
      t_ok "stage 3: filed under a date-stamped name keeping the original";;
    *) t_bad "stage 3: filed under a date-stamped name keeping the original" "${_f##*/}";;
  esac
  if [ -f "$_d/drop/scan001.pdf" ]; then
    t_bad "stage 3: the drop folder is emptied" "the original is still there"
  else
    t_ok "stage 3: the drop folder is emptied"
  fi
  if grep -q OCRED "$_f" 2>/dev/null; then
    t_ok "stage 4: my-ocr was handed the staged file, in place"
  else
    t_bad "stage 4: my-ocr was handed the staged file, in place" "no OCR marker in the result"
  fi
}

# ---- STAGE 4: the batch contract -----------------------------------------
t_stage_batch() {
  _d="$T_TMP/batch"; t_world "$_d"
  for n in 1 2 3; do t_pdf "$_d/drop/s$n.pdf"; done
  "$0" --config "$T_CONF" process --all >/dev/null 2>&1 </dev/null
  _n="$(awk 'END{print NR+0}' "$_d/ocr.args" 2>/dev/null)"
  if [ "$_n" = "3" ]; then
    t_ok "stage 4: all three files go to my-ocr in ONE call"
  else
    t_bad "stage 4: all three files go to my-ocr in ONE call" "got $_n arg(s)"
  fi
  _c="$(find "$_d/done" -name '*.pdf' -type f 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$_c" = "3" ]; then
    t_ok "stage 5: all three are filed"
  else
    t_bad "stage 5: all three are filed" "filed $_c"
  fi
}

# ---- STAGE 5: failure routing --------------------------------------------
t_stage_failure() {
  _d="$T_TMP/fail"; t_world "$_d"
  t_pdf "$_d/drop/BOOM.pdf"
  "$0" --config "$T_CONF" process --all >/dev/null 2>&1 </dev/null
  if [ -n "$(find "$_d/failed" -type f 2>/dev/null)" ]; then
    t_ok "stage 5: my-ocr quarantines what it cannot OCR, via --move-failed-to"
  else
    t_bad "stage 5: my-ocr quarantines what it cannot OCR, via --move-failed-to" \
          "nothing reached the FAILED folder"
  fi
  if [ -z "$(find "$_d/done" -type f 2>/dev/null)" ]; then
    t_ok "stage 5: a failed document never reaches the done folder"
  else
    t_bad "stage 5: a failed document never reaches the done folder" "it was filed anyway"
  fi
}

# ---- concurrency: two 'process' runs must not both take the same file ----
t_concurrent_process() {
  _d="$T_TMP/conc"; t_world "$_d"
  for n in 1 2 3 4; do t_pdf "$_d/drop/c$n.pdf"; done
  "$0" --config "$T_CONF" process --all >/dev/null 2>&1 </dev/null &
  _p1=$!
  "$0" --config "$T_CONF" process --all >/dev/null 2>&1 </dev/null &
  _p2=$!
  wait $_p1 2>/dev/null; wait $_p2 2>/dev/null
  # Count EVERY place a document can legitimately be. Counting only two of
  # them makes a file that is merely still queued look like a lost one.
  _done="$(find "$_d/done"   -name '*.pdf' -type f 2>/dev/null | wc -l | tr -d ' ')"
  _left="$(find "$_d/drop"   -name '*.pdf' -type f 2>/dev/null | wc -l | tr -d ' ')"
  _q="$(   find "$_d/2ocr"   -name '*.pdf' -type f 2>/dev/null | wc -l | tr -d ' ')"
  _fl="$(  find "$_d/failed" -name '*.pdf' -type f 2>/dev/null | wc -l | tr -d ' ')"
  _tot=$(( _done + _left + _q + _fl ))
  if [ "$_tot" -eq 4 ]; then
    t_ok "concurrency: 4 documents in, 4 accounted for (done=$_done queue=$_q failed=$_fl drop=$_left)"
  else
    t_bad "concurrency: 4 documents in, 4 accounted for" \
          "done=$_done queue=$_q failed=$_fl drop=$_left total=$_tot -- $( [ "$_tot" -gt 4 ] && echo DUPLICATED || echo LOST )"
  fi
  _dups="$(find "$_d/done" -type f 2>/dev/null | sed 's/.*___//' | sort | uniq -d | wc -l | tr -d ' ')"
  if [ "$_dups" = "0" ]; then
    t_ok "concurrency: no document was filed twice"
  else
    t_bad "concurrency: no document was filed twice" "$_dups duplicate(s)"
  fi
}

# ---- the workflow Automator has to accept --------------------------------
t_workflow() {
  _d="$T_TMP/wflow"; t_world "$_d"
  "$0" --config "$T_CONF" setup go >/dev/null 2>&1 </dev/null
  _doc="$T_WFDIR/my-scan.workflow/Contents/document.wflow"
  if [ ! -f "$_doc" ]; then t_bad "workflow: setup writes one" "no $_doc"; return 0; fi
  if /usr/bin/plutil -lint "$_doc" >/dev/null 2>&1; then
    t_ok "workflow: the generated plist lints clean"
  else
    t_bad "workflow: the generated plist lints clean" "plutil refused it"
  fi
  _sh="$(/usr/bin/plutil -extract actions.0.action.ActionParameters.shell raw -o - "$_doc" 2>/dev/null)"
  case "$_sh" in
    /bin/zsh|/bin/sh|/bin/bash|/bin/ksh|/bin/csh|/bin/tcsh)
      t_ok "workflow: its shell is one Automator offers ($_sh)";;
    *) t_bad "workflow: its shell is one Automator offers" \
             "'$_sh' -- Automator runs such a step by doing NOTHING, silently";;
  esac
  _fp="$(/usr/bin/plutil -extract workflowMetaData.folderActionFolderPath raw -o - "$_doc" 2>/dev/null)"
  if [ -n "$_fp" ]; then
    t_ok "workflow: it records the folder it serves"
  else
    t_bad "workflow: it records the folder it serves" "empty -> Automator shows 'Choose folder' and nothing arrives"
  fi
}

# ---- an upload caught mid-flight must never be staged --------------------
# Every truncated file found in the live FAILED folder was an exact multiple
# of 4096 bytes with no %%EOF: copied while the FTP daemon was still writing.
# These are the two shapes that failure takes.
t_partial_delivery() {
  _d="$T_TMP/partial"; t_world "$_d"

  # (a) zero bytes -- what a Folder Action sees the instant a file is created.
  # Asserting only "not filed as done" would be VACUOUS: without the guard it
  # settles, stages, and is then refused by the TYPE check, ending in FAILED
  # either way. What must be true is that SETTLE refuses it, and says why.
  : >"$_d/drop/justcreated.pdf"
  _o="$("$0" --config "$T_CONF" --settle-timeout 4 process --all 2>&1 </dev/null)"
  case "$_o" in
    *"empty (0 bytes)"*|*"never settled"*)
      t_ok "partial: settle refuses a 0-byte delivery, and names the reason";;
    *"Unexpected file type"*)
      t_bad "partial: settle refuses a 0-byte delivery, and names the reason" \
        "settle PASSED it; only the later type check caught it -- 0 bytes is size-stable";;
    *)
      t_bad "partial: settle refuses a 0-byte delivery, and names the reason" \
        "$(printf '%s' "$_o" | grep -iE 'settle|type|empty' | head -n 1)";;
  esac
  if [ -n "$(find "$_d/done" -name '*justcreated*' 2>/dev/null)" ]; then
    t_bad "partial: a 0-byte delivery is never filed as done" "it was filed"
  else
    t_ok "partial: a 0-byte delivery is never filed as done"
  fi

  # (b) truncated -- a real PDF cut at a block boundary, no %%EOF
  _d2="$T_TMP/truncated"; t_world "$_d2"
  t_pdf "$_d2/full.pdf"
  dd if="$_d2/full.pdf" of="$_d2/drop/cutoff.pdf" bs=1 count=200 2>/dev/null
  "$0" --config "$T_CONF" --settle-timeout 4 process --all >/dev/null 2>&1 </dev/null
  if [ -n "$(find "$_d2/done" -name '*cutoff*' 2>/dev/null)" ]; then
    t_bad "partial: a truncated PDF is never filed as done" \
      "it does not parse, so settle must refuse it"
  else
    t_ok "partial: a truncated PDF is never filed as done"
  fi
}

# ---- discarding what holds no document ------------------------------------
t_cleanup() {
  _d="$T_TMP/cleanup"; t_world "$_d"
  : >"$_d/failed/2026-09-08_0101.01___nothing.pdf"                 # 0 bytes
  t_pdf "$_d/full.pdf"
  dd if="$_d/full.pdf" of="$_d/failed/2026-09-08_0102.02___cut.pdf" bs=1 count=180 2>/dev/null
  t_pdf "$_d/failed/2026-09-08_0103.03___intact.pdf"               # a real document

  _o="$("$0" --config "$T_CONF" process --cleanup 2>&1 </dev/null)"
  case "$_o" in
    *nothing.pdf*cut.pdf*|*cut.pdf*nothing.pdf*)
      t_ok "cleanup: lists the empty and the truncated file";;
    *) t_bad "cleanup: lists the empty and the truncated file" "$(printf '%s' "$_o" | head -n 2)";;
  esac
  case "$_o" in
    *intact.pdf*) t_bad "cleanup: never lists a file that holds a document" "it offered to delete an intact PDF";;
    *)            t_ok "cleanup: never lists a file that holds a document";;
  esac
  if [ -f "$_d/failed/2026-09-08_0101.01___nothing.pdf" ]; then
    t_ok "cleanup: listing alone removes nothing"
  else
    t_bad "cleanup: listing alone removes nothing" "a bare --cleanup deleted something"
  fi

  "$0" --config "$T_CONF" process --cleanup go >/dev/null 2>&1 </dev/null
  if [ -f "$_d/failed/2026-09-08_0101.01___nothing.pdf" ] || [ -f "$_d/failed/2026-09-08_0102.02___cut.pdf" ]; then
    t_bad "cleanup go: the unrecoverable files are gone" "they are still there"
  else
    t_ok "cleanup go: the unrecoverable files are gone"
  fi
  if [ -f "$_d/failed/2026-09-08_0103.03___intact.pdf" ]; then
    t_ok "cleanup go: the intact document is untouched"
  else
    t_bad "cleanup go: the intact document is untouched" "a real document was deleted"
  fi
}

# ---- a structurally damaged delivery must not reach the OCR ---------------
# settle's parse test only proves pdfinfo can read the catalogue. A file whose
# CONTENT was damaged in transit passes that and fails qpdf -- and OCRing it
# wastes a run and puts a corrupt document in the queue.
t_deep_check() {
  if ! command -v qpdf >/dev/null 2>&1 && [ ! -x /opt/homebrew/bin/qpdf ]; then
    t_ok "deep check: skipped, no qpdf on this host"; return 0
  fi
  _d="$T_TMP/deep"; t_world "$_d"
  t_pdf "$_d/whole.pdf"
  # keep enough for pdfinfo to still read the trailer, but damage the body
  _sz="$(wc -c <"$_d/whole.pdf" | tr -d ' ')"
  dd if="$_d/whole.pdf" of="$_d/drop/damaged.pdf" bs=1 count=$(( _sz - 40 )) 2>/dev/null
  printf 'trailer
<< /Size 5 /Root 1 0 R >>
startxref
9
%%%%EOF
' >>"$_d/drop/damaged.pdf"
  t_pdf "$_d/drop/healthy.pdf"

  "$0" --config "$T_CONF" --settle-timeout 6 process --all >/dev/null 2>&1 </dev/null

  if [ -n "$(find "$_d/done" -name '*healthy*' 2>/dev/null)" ]; then
    t_ok "deep check: a healthy delivery still goes through"
  else
    t_bad "deep check: a healthy delivery still goes through" "it was refused -- false positive"
  fi
  if [ -n "$(find "$_d/done" -name '*damaged*' 2>/dev/null)" ]; then
    t_bad "deep check: a structurally damaged delivery never reaches done" \
      "it was OCRed and filed"
  else
    t_ok "deep check: a structurally damaged delivery never reaches done"
  fi
}

# ---- batches are bounded by PAGES, and pictures are valid input ----------
t_batching() {
  _d="$T_TMP/batching"; t_world "$_d"
  # cap 2 pages: three 1-page documents must arrive as three separate calls
  sed -e 's|^OCR_BATCH_MAX_PAGES=.*|OCR_BATCH_MAX_PAGES=2|' "$T_CONF" >"$_d/conf.cap"
  for n in 1 2 3; do t_pdf "$_d/drop/b$n.pdf"; done
  _o="$("$0" --config "$_d/conf.cap" process --all 2>&1 </dev/null)"
  _c="$(printf '%s' "$_o" | grep -c 'chunk [0-9]*:')"
  if [ "$_c" -ge 2 ]; then
    t_ok "batching: 3 pages with a 2-page cap becomes $_c chunks"
  else
    t_bad "batching: 3 pages with a 2-page cap becomes >1 chunk" "got $_c chunk line(s)"
  fi
  _f="$(find "$_d/done" -name '*.pdf' -type f 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$_f" = "3" ]; then t_ok "batching: every document is still filed ($_f/3)"
  else t_bad "batching: every document is still filed" "filed $_f of 3"; fi

  # a document larger than the cap must still go, alone -- never starved
  _d2="$T_TMP/oversize"; t_world "$_d2"
  sed -e 's|^OCR_BATCH_MAX_PAGES=.*|OCR_BATCH_MAX_PAGES=1|' "$T_CONF" >"$_d2/conf.cap"
  t_pdf "$_d2/drop/big.pdf"
  "$0" --config "$_d2/conf.cap" process --all >/dev/null 2>&1 </dev/null
  if [ -n "$(find "$_d2/done" -name '*big*' 2>/dev/null)" ]; then
    t_ok "batching: a document at/over the cap still runs, on its own"
  else
    t_bad "batching: a document at/over the cap still runs, on its own" "it was starved"
  fi

  # unlimited (0) keeps the old single-call behaviour
  _d3="$T_TMP/nocap"; t_world "$_d3"
  sed -e 's|^OCR_BATCH_MAX_PAGES=.*|OCR_BATCH_MAX_PAGES=0|' "$T_CONF" >"$_d3/conf.cap"
  for n in 1 2 3; do t_pdf "$_d3/drop/n$n.pdf"; done
  "$0" --config "$_d3/conf.cap" process --all >/dev/null 2>&1 </dev/null
  _a="$(awk 'END{print NR+0}' "$_d3/ocr.args" 2>/dev/null)"
  if [ "$_a" = "3" ]; then t_ok "batching: cap 0 means one call for everything"
  else t_bad "batching: cap 0 means one call for everything" "saw $_a arg(s)"; fi
}

t_picture_input() {
  _d="$T_TMP/pics"; t_world "$_d"
  # a real PNG, so 'file' reports PNG and settle can parse it
  /usr/bin/python3 - "$_d/drop/shot.png" <<'_EOPNG_'
import sys, zlib, struct
def chunk(t, d):
    c = t + d
    return struct.pack(">I", len(d)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)
raw = b"\x00" + b"\xff\xff\xff" * 4
png = (b"\x89PNG\r\n\x1a\n"
       + chunk(b"IHDR", struct.pack(">IIBBBBB", 4, 1, 8, 2, 0, 0, 0))
       + chunk(b"IDAT", zlib.compress(raw))
       + chunk(b"IEND", b""))
open(sys.argv[1], "wb").write(png)
_EOPNG_
  # ...and a JPEG, the other format a scanner actually emits
  printf '\377\330\377\340\000\020JFIF\000\001\001\000\000\001\000\001\000\000\377\333\000C\000' >"$_d/drop/photo.jpg"
  printf '%s' "$(printf '\010%.0s' $(seq 1 64))" >>"$_d/drop/photo.jpg"
  printf '\377\300\000\013\010\000\001\000\001\001\021\000\377\311\000\013\001\000\000\000\000\000\000\000\000\377\332\000\010\001\001\000\000?\000\324\077\377\331' >>"$_d/drop/photo.jpg"
  "$0" --config "$T_CONF" process --all >/dev/null 2>&1 </dev/null
  case "$(file --brief "$_d/done"/*photo* 2>/dev/null)$(file --brief "$_d/failed"/*photo* 2>/dev/null)" in
    JPEG*) t_ok "pictures: a JPEG is accepted as input too";;
    *)     t_ok "pictures: JPEG fixture not recognised here -- accept-list still lists JPEG";;
  esac
  if [ -n "$(find "$_d/done" -name '*shot*' 2>/dev/null)" ]; then
    t_ok "pictures: a PNG is accepted and goes through (1 picture = 1 page)"
  else
    _w="$(find "$_d/failed" -name '*shot*' 2>/dev/null)"
    t_bad "pictures: a PNG is accepted and goes through" \
      "${_w:+quarantined as the wrong type: }${_w:-it vanished} -- my-ocr accepts PNG, my-scan must too"
  fi
}

# ---- my-scan and my-ocr must accept the SAME input types ------------------
t_types_agree() {
  _mo="$(sed -n 's/^MY_OCR="\(.*\)"/\1/p' <"$T_CONF" 2>/dev/null)"
  _real="$("$0" --create-config 2>/dev/null | sed -n 's/^MY_OCR="\(.*\)"/\1/p')"
  [ -x "$_real" ] || { t_ok "type agreement: my-ocr not installed here -- skipped"; return 0; }
  _ours="$("$0" --create-config 2>/dev/null | sed -n 's/^ACCEPT_FILE_TYPE_REGEX="\(.*\)"/\1/p')"
  _theirs="$(sed -n 's/^ *S_EXPECTED_FILE_TYPE___REGEX="\([^"]*\)".*/\1/p' "$_real" | head -n 1)"
  # compare the sets, order and spacing aside
  # shellcheck disable=SC1003  # stripping a literal backslash out of the regex
  _a="$(printf '%s' "$_ours"   | tr -d ' \\' | tr '|' '\n' | sort | tr '\n' ',')"
  # shellcheck disable=SC1003  # stripping a literal backslash from the regex
  _b="$(printf '%s' "$_theirs" | tr -d ' \\' | tr '|' '\n' | sort | tr '\n' ',')"
  if [ "$_a" = "$_b" ]; then
    t_ok "type agreement: my-scan and my-ocr accept the same types ($_a)"
  else
    t_bad "type agreement: my-scan and my-ocr accept the same types" \
      "my-scan=[$_a] my-ocr=[$_b] -- a type only one accepts stages then fails"
  fi
}

# ---- the one slow line comes last ----------------------------------------
t_status_order() {
  _d="$T_TMP/order"; t_world "$_d"
  # a device that cannot answer: the ping then costs its full timeout
  sed -e 's|^SCAN_DEVICE=.*|SCAN_DEVICE="http://192.0.2.1/eSCL"|' "$T_CONF" >"$_d/conf.dev"
  _last="$("$0" --config "$_d/conf.dev" status 2>/dev/null </dev/null | grep -v '^[[:space:]]*$' | tail -n 1)"
  case "$_last" in
    SCANNER*) t_ok "status: SCANNER is printed LAST (it is the only slow line)";;
    *) t_bad "status: SCANNER is printed LAST (it is the only slow line)" \
             "last line was: $_last -- the pipeline state waits behind a ping";;
  esac
}

# ---- leftovers must be recoverable ---------------------------------------
t_retry() {
  _d="$T_TMP/retry"; t_world "$_d"
  # a file stranded in the OCR queue by a crashed run, and one my-ocr failed
  t_pdf "$_d/2ocr/2026-09-08_0101.01___stranded.pdf"
  t_pdf "$_d/failed/2026-09-08_0102.02___didnotwork.pdf"

  # listing changes nothing
  _o="$("$0" --config "$T_CONF" process --retry 2>&1 </dev/null)"
  case "$_o" in
    *stranded.pdf*) t_ok "retry: bare '--retry' LISTS the stranded queue";;
    *) t_bad "retry: bare '--retry' LISTS the stranded queue" "$(printf '%s' "$_o"|tail -2)";;
  esac
  if [ -f "$_d/2ocr/2026-09-08_0101.01___stranded.pdf" ]; then
    t_ok "retry: listing does not move anything"
  else
    t_bad "retry: listing does not move anything" "the file moved on a mere listing"
  fi
  # ...and it does NOT sweep the failed folder in by default
  case "$_o" in
    *didnotwork*) t_bad "retry: FAILED files need saying so explicitly" \
                    "a bare --retry re-fed a file that already defeated the OCR";;
    *) t_ok "retry: FAILED files need saying so explicitly";;
  esac

  # --all does the work; the stranded file is OCRed and filed
  "$0" --config "$T_CONF" process --retry --all >/dev/null 2>&1 </dev/null
  if [ -n "$(find "$_d/done" -name '*stranded*' 2>/dev/null)" ]; then
    t_ok "retry --all: the stranded file is OCRed and filed"
  else
    t_bad "retry --all: the stranded file is OCRed and filed" "it is still not in done/"
  fi
  if [ -f "$_d/failed/2026-09-08_0102.02___didnotwork.pdf" ]; then
    t_ok "retry --all: the FAILED folder was left alone"
  else
    t_bad "retry --all: the FAILED folder was left alone" "it was swept in unasked"
  fi

  # 'failed' opts in, and the file goes back through the queue
  "$0" --config "$T_CONF" process --retry failed --all >/dev/null 2>&1 </dev/null
  if [ -n "$(find "$_d/done" -name '*didnotwork*' 2>/dev/null)" ]; then
    t_ok "retry failed --all: the FAILED file is re-fed on request"
  else
    t_bad "retry failed --all: the FAILED file is re-fed on request" "it stayed put"
  fi
}

# ---- a listing must reach the TERMINAL even when logging is on ------------
# This is the configuration every real machine runs (LOG is set), and it is the
# one the suite did NOT exercise -- so a listing that answered into the logfile
# went unnoticed until it was seen on a live host.
t_listing_not_swallowed_by_log() {
  _d="$T_TMP/logging"; t_world "$_d"
  sed -e "s|^LOG=.*|LOG=\"$_d/my-scan.log\"|" "$T_CONF" >"$_d/conf.log"
  t_pdf "$_d/drop/pending.pdf"
  t_pdf "$_d/2ocr/2026-09-08_0101.01___stranded.pdf"

  _o="$("$0" --config "$_d/conf.log" process 2>&1 </dev/null)"
  case "$_o" in
    *pending.pdf*) t_ok "listing: 'process' answers on stdout with LOG set";;
    *) t_bad "listing: 'process' answers on stdout with LOG set" \
             "it went to the logfile, where the user cannot see it";;
  esac
  _o="$("$0" --config "$_d/conf.log" process --retry 2>&1 </dev/null)"
  case "$_o" in
    *stranded.pdf*) t_ok "listing: '--retry' answers on stdout with LOG set";;
    *) t_bad "listing: '--retry' answers on stdout with LOG set" \
             "it went to the logfile";;
  esac
  # ...and real work still goes to the log
  "$0" --config "$_d/conf.log" process --all >/dev/null 2>&1 </dev/null
  if [ -s "$_d/my-scan.log" ]; then
    t_ok "logging: actual processing is still written to the logfile"
  else
    t_bad "logging: actual processing is still written to the logfile" "log is empty"
  fi
}

# ---- reset must hand my-ocr's machinery back to my-ocr --------------------
t_reset_delegates() {
  # shellcheck disable=SC2016  # matching a literal '$MY_OCR' in the source
  if awk '/^do_reset\(\) \{/,/^\}/' "$0" | grep -q '"\$MY_OCR" reset'; then
    t_ok "reset delegates my-ocr's machinery to 'my-ocr reset'"
  else
    t_bad "reset delegates my-ocr's machinery to 'my-ocr reset'" \
      "my-scan would have to know my-ocr's internal state files"
  fi
}

# ---- my-ocr's own suite, because the two belong together -----------------
t_my_ocr_suite() {
  # the REAL my-ocr, not the stub: read it from a default config, since
  # --run-tests deliberately loads no config of its own.
  _mo="$("$0" --create-config 2>/dev/null | sed -n 's/^MY_OCR="\(.*\)"/\1/p')"
  if [ -z "$_mo" ] || [ ! -x "$_mo" ]; then
    t_ok "my-ocr: not installed here ('${_mo:-unset}') -- its suite is skipped"
    return 0
  fi
  _o="$("$_mo" --run-tests 2>&1 </dev/null)"
  _r=$?
  _line="$(printf '%s' "$_o" | grep -E '^ +[0-9]+ passed' | tail -n 1)"
  if [ "$_r" -eq 0 ]; then
    t_ok "my-ocr: its own suite passes (${_line:-no summary})"
  else
    t_bad "my-ocr: its own suite passes" "${_line:-rc=$_r}"
    printf '%s\n' "$_o" | grep '  FAIL' | sed 's/^/        /'
  fi
}

do_run_tests() {
  _p "$US --run-tests   ($(head -1 "$0"))"
  T_TMP="$(mktemp -d /tmp/my-scan.tests.XXXXXX)" || { _p "mktemp failed"; return 1; }
  t_stage_inputs
  t_stage_settle
  t_stage_staging
  t_stage_batch
  t_stage_failure
  t_concurrent_process
  t_workflow
  t_partial_delivery
  t_deep_check
  t_cleanup
  t_batching
  t_picture_input
  t_types_agree
  t_status_order
  t_retry
  t_listing_not_swallowed_by_log
  t_reset_delegates
  t_my_ocr_suite
  rm -rf "$T_TMP"
  _p "  ----"
  printf '  %d passed, %d failed\n' "$T_PASS" "$T_FAIL"
  [ "$T_FAIL" -eq 0 ]
}

##############################################################################
#### USAGE

usage() {
cat <<_EOU_
usage: $US [OPTIONAL] <MANDATORY> parameters.

  $US                                                   print this usage
  $US scan     [OPTIONS] [<FNAME.pdf> [SCANNER_PARAMS...]]  pull-scan a device
  $US process  [OPTIONS] [--all]                    filenames on stdin, or --all
  $US process --retry [failed|all] [--all]          re-feed leftovers
  $US process --cleanup [go]                        discard what cannot be recovered
  $US setup    [OPTIONS] [go]                       install the Folder Action
  $US install  [OPTIONS] [go]                       synonym for 'setup'
  $US uninstall [OPTIONS] [go]                      remove the Folder Action + workflow
  $US status   [OPTIONS]                            what the pipeline is doing
  $US cancel   [OPTIONS] [<ID>...]                  documents in flight
  $US reset    [OPTIONS]                            stuck machinery (never documents)
  $US devices  [OPTIONS]                            find scanners on this LAN
  $US stamp-version                                 record the commit in this file

$US receives documents that the scanner pushes to a watched folder over SMB
or FTP, waits until each delivery is actually complete, hands it to the OCR
application, verifies the result and files it. It can also pull-scan a device
directly ('scan'). Which scanner, which OCR application and which folders is
all decided by the config file -- see CONFIG below, and 'my-scan status'.

OPTIONS:
  -h|--help                 Print this text
  -Q|--quiet                Quiet except errors (for cron / LaunchDaemons)
  -V|--verbose              Echo each command and explain it as it runs
  -D|--debug [<PATH>]       Everything -V shows, plus diagnostics; append to PATH
  -DD|--deepdebug [<PATH>]  Everything -D shows, plus full shell tracing
  -L|--no-log               Do not write to the configured logfile
  --watch [<SEC>]           'status' only: live view. Records each change as a
                            timestamped line rather than repainting, so the
                            history stays on screen. Exits once the pipeline is
                            drained. Default WATCH_INTERVAL (fractions OK: 0.5)
  --config <FILE>           Use this config file, bypassing the search
  --create-config [<FILE>]  Print the default config, or write it to FILE
  --dry-run                 Show what would change; change nothing
  --version                 Print version, commit and build id
  --run-tests               Run the regression suite -- every stage of my-scan
                            against temp dirs and a stub my-ocr, then my-ocr's
                            own suite. Starts no scan and no OCR.

SCAN OPTIONS:
  -w|--wait                 Wait for a document in the feeder
  -d|--duplex               Expect a DUPLEX document in the feeder (implies -w)
  -r|--resolution <DPI>     75 | 100 | 200 | 300 | 600
  -g|--grey|--gray          Scan greyscale instead of colour


SETTLE:
  Every delivery is settled by 'process' before it is touched: no
  SMB/FTP writer holds it, its size has stopped changing, and it parses.
  'status -V' reports which of the three a still-waiting file is failing.
  --settle-timeout <SEC>    Override SETTLE_TIMEOUT for this run

CONFIG:
  Searched in this order, first existing wins:
    \$MY_SCAN_CONFIG, --config <FILE>, /LINKS/default/my-scan,
    ~/.my-scan.conf, /etc/my-scan.conf, /usr/local/etc/my-scan.conf

EXAMPLES:
  $US                                     print this usage
  $US scan                                scan the feeder, else the flatbed
  $US --duplex bank-statement.pdf         duplex scan to a named file
  $US setup                               dry-run the Folder Action install
  $US setup go                            apply it
  $US uninstall                           dry-run removing the Folder Action
  $US uninstall go                        remove the wiring; documents stay put
  $US -V status                           ...and why a delivery is not moving
  $US status --watch                      live: one line per change, until drained
  $US status --watch 0.5                  ...polling twice a second
  echo /path/to/scan.pdf | $US process     (what the Folder Action runs)
  $US process                             list what is pending, change nothing
  $US process --all                       process the whole backlog
  $US process --retry                     list what is stranded in the OCR queue
  $US process --retry --all               hand it back to my-ocr
  $US process --retry failed --all        ...and the ones my-ocr could not do
  $US process --cleanup                   list empty/truncated files (no document in them)
  $US process --cleanup go                move those to the Trash
  ls -1d <dir>/* | head -10 | $US process process just those ten
_EOU_
  exit 0
}


##############################################################################
#### MAIN

ARGS=""
while [ $# -gt 0 ]; do
  _a="$1"; shift
  case "$_a" in
    -h|--help|help)      usage ;;
    --version)           do_version; exit 0 ;;
    -Q|--quiet)          QUIET=1 ;;
    -V|--verbose)        VRB=1 ;;
    -D|--debug)          DBG=1; case "$1" in ""|-*) ;; *) DBG_LOGFILE="$1"; shift ;; esac ;;
    -DD|--deepdebug)     DEEPDBG=1; case "$1" in ""|-*) ;; *) DBG_LOGFILE="$1"; shift ;; esac ;;
    -L|--no-log)         NO_LOG=1 ;;
    --run-tests)         RUN_TESTS=1 ;;
    --watch)             WATCH=1; case "$1" in ""|-*) ;; *) WATCH_INTERVAL_OVERRIDE="$1"; shift ;; esac ;;
    --watch=*)           WATCH=1; WATCH_INTERVAL_OVERRIDE="${_a#--watch=}" ;;
    --dry-run)           DRY_RUN=1 ;;
    --config)            CONFIG="$1"; shift ;;
    --config=*)          CONFIG="${_a#--config=}" ;;
    --create-config)     CREATE_CONFIG=1; case "$1" in ""|-*) ;; *) CREATE_CONFIG_FILE="$1"; shift ;; esac ;;
    --create-config=*)   CREATE_CONFIG=1; CREATE_CONFIG_FILE="${_a#--create-config=}" ;;
    --settle-timeout)    SETTLE_TIMEOUT_OVERRIDE="$1"; shift ;;
    -w|--wait)           WAIT_FOR_ADF=1 ;;
    -d|--duplex)         WAIT_FOR_ADF=1; DUPLEX=1 ;;
    -g|--grey|--gray)    SCAN_MODE_OVERRIDE="Gray" ;;
    -r|--resolution)     isInt "$1" || err 074 "--resolution needs an integer, got '$1'."
                         SCAN_DPI_OVERRIDE="$1"; shift ;;
    --all)               CANCEL_ALL=1; RESET_ALL=1; PROCESS_ALL=1 ;;
    --retry)             PROCESS_RETRY="queue"
                         case "$1" in failed|all) PROCESS_RETRY="$1"; shift ;; esac ;;
    --cleanup)           PROCESS_CLEANUP=1
                         case "$1" in go) PROCESS_CLEANUP_GO=1; shift ;; esac ;;
    --yes)               ASSUME_YES=1 ;;
    -S|--status)         WHAT="status" ;;
    scan|process|setup|install|uninstall|status|cancel|reset|devices|stamp-version)
                         # the first such bare word is the subcommand; a later
                         # one is an ordinary argument (a file may be named "scan")
                         if [ -z "$WHAT" ]; then WHAT="$_a"; else ARGS="$ARGS${NL}$_a"; fi ;;
    *)                   ARGS="$ARGS${NL}$_a" ;;
  esac
done

# implication chain -- enforced once, right here
[ "$DEEPDBG" = "1" ] && DBG=1
[ "$DBG" = "1" ] && VRB=1
[ "$VRB" = "1" ] && QUIET=0
[ "$DEEPDBG" = "1" ] && { PS4='+ '; set -x; }

# --create-config needs no config file
[ -n "$CREATE_CONFIG" ] && { do_create_config; exit 0; }

# stamp-version edits this file and needs no config either
[ "$WHAT" = "stamp-version" ] && { do_stamp_version; exit 0; }
# --run-tests builds its own worlds and configs, so it needs no config of its own
[ -n "$RUN_TESTS" ] && { do_run_tests; exit $?; }

load_config

# argv overrides config
[ -n "$SCAN_MODE_OVERRIDE" ]     && SCAN_MODE="$SCAN_MODE_OVERRIDE"
[ -n "$SCAN_DPI_OVERRIDE" ]      && SCAN_DPI="$SCAN_DPI_OVERRIDE"
[ -n "$SETTLE_TIMEOUT_OVERRIDE" ] && SETTLE_TIMEOUT="$SETTLE_TIMEOUT_OVERRIDE"
# Only a value the USER typed is an error worth stopping for. A config file
# written before WATCH_INTERVAL existed simply has no such key -- that must not
# break every invocation of a tool whose main job has nothing to do with it.
if [ -n "$WATCH_INTERVAL_OVERRIDE" ]; then
  isNum "$WATCH_INTERVAL_OVERRIDE" \
    || err 079 "--watch interval '$WATCH_INTERVAL_OVERRIDE' is not a positive number."
  WATCH_INTERVAL="$WATCH_INTERVAL_OVERRIDE"
fi

NOW="$(date +"%Y-%m-%d_%H%M.%S")"

# positional arguments
set --
while IFS= read -r _a; do
  [ -z "$_a" ] && continue
  set -- "$@" "$_a"
done <<_EOARGS_
$ARGS
_EOARGS_


RC=0
# shellcheck disable=SC2317  # do_process/do_watch exit; the others return here
# A bare 'my-scan' prints the usage. It is what you type when you are not sure
# what the tool does, and 'scan' -- the one subcommand that drives hardware --
# is the wrong thing to start from a stray Enter.
case "${WHAT:-usage}" in
  usage)    usage ;;
  scan)     do_scan "$@";     RC=$? ;;
  process)  do_process;      RC=$? ;;
  setup|install)  do_setup "$@";    RC=$? ;;
  uninstall)      do_uninstall "$@"; RC=$? ;;
  status)   if [ -n "$WATCH" ]; then do_watch_status; else do_status ""; fi; RC=$? ;;
  cancel)   do_cancel "$@";  RC=$? ;;
  reset)    do_reset;        RC=$? ;;
  devices)  do_devices;       RC=$? ;;
  *)        err 075 "Unknown subcommand '$WHAT'. See --help." ;;
esac

# the subcommand's verdict is the tool's exit status -- a caller that pipes
# 'settle' into something else must be able to see that it failed
exit $RC
