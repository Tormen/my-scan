#!/bin/dash
#
# my-scan -- receive, settle, OCR and file scanned documents.
#
# Harmonises what used to be four scripts:
#   my-scan                                 -> 'scan'    (pull-scan a device)
#   my-scan-folder-spooler                  -> 'settle'  (wait for a complete file)
#   my-scan-processor-macos                 -> 'process' (OCR now goes to my-ocr)
#   my-scan-processor-macos___wait-for-ocr  -> 'watch'   (OCR deblock watchdog)
#
# 081 == highest used errCode

SCRIPT_VERSION="v1.1"
SCRIPT_COMMIT="c51d516"   # rewritten by 'my-scan stamp-version'; authoritative at runtime

US="${0##*/}"

PID="$(/usr/bin/printf "%06d" "$$")"   # IDENTITY: goes into lock names and "___,ID,<pid>"
LOGPFX="$PID"                          # LOG COLUMN only; the watchdog widens it

NL="
"
TAB="$(printf '\t')"

# settle has to run wherever the scanner drops files, so nothing below may
# assume one userland. BSD and GNU differ in exactly the places settle uses.
MY_OS="$(uname -s)"
LSOF_WARNED=""      # warn once, not every poll


##############################################################################
#### FLAG STATE (set from argv; NO behaviour defaults live here -- see the
#### config file, whose only source is _default_config_content() below)

QUIET=0
VRB=
DBG=
DEEPDBG=
DBG_LOGFILE=

CONFIG=                  # --config <FILE>
CREATE_CONFIG=           # --create-config [<FILE>]
CREATE_CONFIG_FILE=
DRY_RUN=
NO_LOG=                  # -L|--no-log
CANCEL_ALL=
RESET_ALL=
PROCESS_ALL=
PROCESS_RETRY=          # --retry [failed] : re-feed leftovers, not the drop folder
PROCESS_CLEANUP=        # --cleanup : discard what is provably unrecoverable
PROCESS_CLEANUP_GO=     # --cleanup go : and actually do it
WE_HOLD_STAGE_LOCK=
ASSUME_YES=
WHAT=                    # subcommand
REDIRECT_TO_LOG=
LOG_IS_STDERR=          # stderr has been redirected into $LOG

# counters
INP_FILES=
INP_FILES_CNT=0
FILES_OCRED_CNT=0
FAILED_CNT=0
WRONG_FILETYPE_CNT=0
IGNORED_CNT=0



##############################################################################
#### OUTPUT HELPERS
##
## Prefix convention:  " >>> " major   "  >> " medium   "    > " minor detail
##                     " ~~~ " debug   "   ~ " deep debug
## In pipeline (process/watch) mode every line is additionally prefixed with
## the PID column so concurrent runs stay readable in one shared log.

_p() { printf '%s\n' "$*"; }

# pipeline-prefixed echo (the log format the Automator-driven parts use)
pe() { printf '%s|%s\n' "$LOGPFX" "$*"; }

msg()  { [ "$QUIET" = "1" ] && return 0; _p " >>> $*"; }
msg2() { [ "$QUIET" = "1" ] && return 0; _p "  >> $*"; }
det()  { [ "$QUIET" = "1" ] && return 0; _p "    > $*"; }

vrb()  { [ "$VRB" = "1" ] || return 0; _p " >>> $*"; }
vdet() { [ "$VRB" = "1" ] || return 0; _p "    > $*"; }

dbg()  { [ "$DBG" = "1" ] || return 0; _p " ~~~ $*" 1>&2
         [ -n "$DBG_LOGFILE" ] && printf '%s ~~~ %s\n' "$(date -u +%FT%TZ)" "$*" >>"$DBG_LOGFILE"
         return 0; }
ddbg() { [ "$DEEPDBG" = "1" ] || return 0; _p "   ~ $*" 1>&2; return 0; }

indent() { # $1 = text, $2 = prefix
  [ -z "$1" ] && return 0
  _ind_pfx="$2"
  [ -z "$_ind_pfx" ] && _ind_pfx="$LOGPFX|     | "
  # not sed: the prefix routinely contains "|", which would be read as the
  # substitute delimiter and break the expression
  printf '%s\n' "$1" | while IFS= read -r _ind_l; do
    printf '%s%s\n' "$_ind_pfx" "$_ind_l"
  done
}

# run(): single source of truth for the echoed command and the executed one
run() {
  [ "$VRB" = "1" ] && _p " >>> $*"
  "$@"
}

# set exitCode to "-" to report without exiting
# shellcheck disable=SC2154  # set by the sourced config file
err() {
  _errCode="$1"
  [ -z "$2" ] && _msg="Please fix." || _msg="$2"
  [ -z "$3" ] && _exitCode=1 || _exitCode="$3"
  _outp="ERROR $_errCode [$_exitCode]: $_msg"
  _now="$(date +"%Y-%m-%d_%H%M.%S")"

  # make sure the error reaches the log even while stdout is restored
  if [ -n "$LOG" ] && [ -z "$REDIRECT_TO_LOG" ] && [ -z "$LOG_IS_STDERR" ]; then
    { echo; pe ""; pe "$_now|$_outp"; } >>"$LOG" 2>/dev/null
  fi
  { echo; pe ""; pe "$_now|$_outp"; } 1>&2

  if [ -n "$NFY" ] && [ -x "$my_notify" ]; then
    pe "LAUNCHING: \"$my_notify\" -- \"ERROR $_errCode [$_exitCode]:\" \"$_msg\"" 1>&2
    "$my_notify" -- "ERROR $_errCode [$_exitCode]:" "$_msg"
  fi

  [ "$_exitCode" != "-" ] && exit "$_exitCode"
  return 0
}

isInt() { [ "$1" -eq "$1" ] 2>/dev/null; }
# WATCH_INTERVAL may be fractional, so isInt cannot validate it
isNum() {
  case "$1" in
    ''|*[!0-9.]*|*.*.*) return 1 ;;
    .|.*[!0-9]*)        return 1 ;;
  esac
  [ "$1" != "." ] && [ "$1" != "0" ] && [ "$1" != "0.0" ]
}


##############################################################################
#### CONFIG

_default_config_content() {
cat <<'_EOCONF_'
#!/bin/dash
#
# my-scan configuration -- plain shell, sourced at startup.
#
# Search order (first existing wins):
#   $MY_SCAN_CONFIG                     env var, escape hatch for CI / tests
#   --config <FILE>                     explicit, bypasses the search
#   /LINKS/default/my-scan              primary system-wide location
#   ~/.my-scan.conf                     per-user override
#   /etc/my-scan.conf                   system default
#   /usr/local/etc/my-scan.conf         fallback
#
# Every runtime-tunable value lives here. The script body carries no defaults.

WHOAMI="$(/usr/bin/whoami)"

##### LOGGING / NOTIFICATION ################################################

LOG="/var/log/mine/$WHOAMI/my-scan.log"   # "" turns the logfile off
NFY=""                                    # 1 = notify (my-notify) on error
my_notify="/LINKS/bin/my-notify"

# HOW my-scan reaches you. Comma-separated, any combination:
#   notify  = desktop notification
#   mail    = email (my-notify --mail)
#   ""      = neither; the logfile only
NOTIFY_VIA="notify,mail"

# Empty means "let my-notify use its own configured default", so the address
# lives in ONE place unless you deliberately want my-scan's mail to go
# somewhere else.
NOTIFY_MAIL_TO=""                         # recipient
NOTIFY_MAIL_FROM=""                       # sender

# Prefixed to every subject, so a mail rule can pick these out at a glance.
NOTIFY_SUBJECT_MARKER="[my-scan]"

# A delivery that arrives EMPTY or TRUNCATED means a document was scanned and
# never made it -- the bytes are gone, and only you can rescan it. That is
# worth telling someone about rather than quarantining in silence, which is
# how five such documents went unnoticed for months.
NOTIFY_ON_BAD_DELIVERY=1                  # "" turns it off

# Names in a watched folder that are NEVER documents: Finder droppings, the
# FTP daemon's own bookkeeping, editor swap files. Space-separated globs,
# matched against the BASENAME. my-scan must not try to read these -- the FTP
# daemon's '.ftpquota' is not even readable by us, and settling it fails.
IGNORE_FILENAME_PATTERNS=".* @eaDir *~ *.part *.crdownload"

# Page counts cost one pdfinfo per document (~22ms) and there is no bulk call:
# mdls would answer from Spotlight's index in one process, but returns (null)
# for anything Spotlight has not indexed -- which is the interesting folders.
# So cache instead, keyed by size+mtime: a document that has not changed is
# never counted twice, and 'status' stays fast after its first run.
PAGE_CACHE="/var/lib/mine/$WHOAMI/my-scan.pagecache"   # "" disables the cache
PAGE_CACHE_MAX=5000                       # lines; pruned oldest-first past this

# One way out to a person, honouring NOTIFY_VIA. my-notify's --mail takes 1-4
# parameters and infers the meaning from how many: subject / subject+body /
# to+subject+body / from+to+subject+body -- so an unset address simply falls
# back to my-notify's own default rather than being passed as an empty string.
notify_user() { # $1 = subject, $2 = body (optional)
  [ -n "$NOTIFY_VIA" ] || return 0
  [ -x "$my_notify" ] || { pe " >>> cannot notify: '$my_notify' not executable"; return 0; }
  _nu_s="${NOTIFY_SUBJECT_MARKER:+$NOTIFY_SUBJECT_MARKER }$1"

  case ",$NOTIFY_VIA," in
    *,notify,*) "$my_notify" -- "$_nu_s" "${2:-}" >/dev/null 2>&1 ;;
  esac
  case ",$NOTIFY_VIA," in
    *,mail,*)
      if   [ -n "$NOTIFY_MAIL_FROM" ] && [ -n "$NOTIFY_MAIL_TO" ]; then
        "$my_notify" --mail "$NOTIFY_MAIL_FROM" "$NOTIFY_MAIL_TO" "$_nu_s" "${2:-}" >/dev/null 2>&1
      elif [ -n "$NOTIFY_MAIL_TO" ]; then
        "$my_notify" --mail "$NOTIFY_MAIL_TO" "$_nu_s" "${2:-}" >/dev/null 2>&1
      else
        "$my_notify" --mail "$_nu_s" "${2:-}" >/dev/null 2>&1
      fi
      [ "$?" -eq 0 ] || pe " >>> WARNING: could not send the mail (my-notify alerts itself)" ;;
  esac
  return 0
}

# A delivery that never arrived intact. Says WHAT is wrong and WHAT TO DO,
# because the only remedy is at the scanner: the bytes are not recoverable.
notify_bad_delivery() { # $1 = file, $2 = what is wrong
  [ -n "$NOTIFY_ON_BAD_DELIVERY" ] || return 0
  notify_user "scan lost in transfer: ${1##*/}" \
"'${1##*/}' arrived $2.

The document was scanned but the bytes never made it -- an FTP/SMB upload that
stopped part-way leaves exactly this. It cannot be recovered from here, so the
document has to be SCANNED AGAIN.

It has been quarantined in:
  $T_PATH_FAILED

Host: $(hostname -s)"
  return 0
}

##### THE SCANNER (pull-scanning: 'my-scan scan') ###########################

# Human-readable name, printed by 'status' and 'devices'.
SCAN_DEVICE_NAME="EPSON EM-C7100 Series"

# Device as the scan backend addresses it. Either a SANE device name
#   epson2:net:<ip>            /  epsonscan2:net:<ip>
# or an eSCL/AirScan base URL
#   http://<ip>/eSCL
#
# It must carry an ADDRESS, not a Bonjour name. Printing does not need one --
# a macOS print queue stores the mDNS service name ("dnssd://...local./") and
# re-resolves it at print time -- but that also means the address is written
# down nowhere, and a printer that is switched off has no mDNS record to
# resolve at all. 'my-scan devices' can only find one that is powered on.
SCAN_DEVICE="http://CHANGEME/eSCL"

# 1 if the scanner is normally powered off. Then 'status' reports it as
# "not answering (normally off)" rather than UNREACHABLE, so a switched-off
# scanner does not read as a fault. The exit code is printed either way.
SCAN_DEVICE_USUALLY_OFF=""

# Backend binary. "" = autodetect (scanimage, then epsonscan2, then eSCL/curl).
c_scanimage=""

SCAN_MODE="Color"        # Lineart | Gray | Color
SCAN_DPI="200"           # 75 | 100 | 200 | 300 | 600
SCAN_SOURCE="ADF"        # Flatbed | ADF | Duplex
SCAN_FORMAT="png"
SCAN_DEFAULT_OPTS="--format png"
SCAN_OUT_PATH="/CHANGEME/scans-out"  # results land here; relative names resolve here
SCAN_DEFAULT_FNAME=".scan.pdf"
# Opened on the finished scan. "" = do not open anything (for unattended use).
# The old Linux-era defaults (masterpdfeditor5 / okular) exist on neither Mac.
#   macOS : open -a Preview
#   Linux : xdg-open
# It is run as: $SCAN_VIEWER_CMD "<file>"
SCAN_VIEWER_CMD="open -a Preview"

##### DELIVERY (where the scanner drops finished files) #####################

# The scanner pushes scans here. List every watched drop folder, space
# separated -- 'setup' attaches a Folder Action to each, 'status' counts each.
DROP_PATHS="/Users/CHANGEME/services/ftp/in/scans"

# Label shown per drop path in 'status', in the same order. Free text.
DROP_LABELS="ftp"

##### SETTLE (was: my-scan-folder-spooler) ##################################

# A file is settled when no writer holds it, its size is stable, and it parses.
SETTLE_TIMEOUT=600                 # seconds, whole settle for one file
SETTLE_POLL=1                      # seconds between polls
SETTLE_STABLE_POLLS=3              # consecutive equal sizes required
# Processes whose write handle means "still being delivered" (SMB *and* FTP):
SETTLE_WRITER_PROCS="smbd pure-ftpd pureftpd vsftpd ftpd proftpd"
SETTLE_LSOF_TIMEOUT=10             # seconds; lsof itself has no timeout
# Where to look for lsof when c_lsof is unset or wrong. It sits in a different
# place per OS, so this is a list, not a path.
SETTLE_LSOF_SEARCH="/usr/sbin/lsof /usr/bin/lsof /opt/homebrew/bin/lsof /usr/local/bin/lsof"
SETTLE_BACKUP_PATH=""              # "" = no backup copy of the raw delivery

##### PROCESS (was: my-scan-processor-macos) ################################

T_PATH_DONE="/CHANGEME/scans"
T_PATH_FAILED="/CHANGEME/scans/02_FAILED_OCR"

# Where a settled delivery waits while my-ocr works on it. There is no
# "part 1" and "part 2" any more, so the old PART*_?_PATH names are gone:
# a delivery is read from DROP_PATHS, waits here, and is filed in T_PATH_DONE.
OCR_QUEUE_PATH="/CHANGEME/scans/01_scans_2ocr"

# Accepted input, as the BEGINNING of `file --brief` output. A light check
# only: my-ocr does the deep validation and knows more about it than my-scan
# should.
# What 'process' will hand to my-ocr. Pictures are fine: the OCR application
# turns them into a searchable PDF, and my-ocr accepts the same set. Keep this
# in step with my-ocr's S_EXPECTED_FILE_TYPE___REGEX -- a type accepted here
# and refused there is a document that settles, stages, and then fails. Each of
# these was tried against the real OCR application, not assumed: TIFF was added
# only after FineReader was shown to accept one and return a searchable PDF.
ACCEPT_FILE_TYPE_REGEX="JPEG \|PDF \|PNG \|TIFF "

# Filenames matching these shell patterns skip OCR and go straight to DONE:
NO_OCR_PATTERNS="no-ocr-scan*"

##### OCR APPLICATION #######################################################

# my-scan does not drive the OCR application -- my-ocr does. These two are
# only so 'status' and 'setup' can say whether it is installed and running.
# Languages, the producer tag, how to kill it: all my-ocr's business.
OCRAPP_NAME="FineReader"
OCRAPP_PATH="/Applications/FineReader.app"

##### FOLDER ACTION / AUTOMATOR (used by 'setup') ###########################

WORKFLOW_DIR="$HOME/Library/Workflows/Applications/Folder Actions"
WORKFLOW_NAME="my-scan.workflow"
# Shell for the workflow's Run Shell Script step. This is NOT my-scan's own
# shell -- it is the one-line glue Automator runs, and Automator accepts only
# the shells in its own list. /bin/dash is NOT one of them: the action then
# does nothing at all, with no error and nothing in any log, so the Folder
# Action looks dead. The command itself is POSIX and runs under any of them.
# Automator offers exactly: /bin/bash /bin/csh /bin/ksh /bin/sh /bin/tcsh
#   /bin/zsh /usr/bin/perl /usr/bin/ruby /usr/local/bin/python /usr/local/bin/python3
WORKFLOW_SHELL="/bin/zsh"
WORKFLOW_BACKUPS_KEEP=3            # older generated-workflow backups are pruned
# 'status --watch' poll interval, seconds; fractions allowed (0.5). It must be
# SHORTER than the briefest state you want to see: the quickest is settle, at
# SETTLE_POLL x SETTLE_STABLE_POLLS (3s today), so 1s always catches it.
# Transitions that are a single rename() have NO duration -- those are caught
# as an appear/disappear pair, never by polling faster.
WATCH_INTERVAL=1
# Seconds a 'process' run waits for another run to finish claiming files out of
# the drop folder. Staging is quick; this only has to outlast a big backlog.
STAGE_LOCK_TIMEOUT=300

# How many PAGES my-scan hands to my-ocr in one call. Pages, not files: ten
# one-page receipts and ten 200-page contracts are the same file count and
# wildly different work, so a file count bounds nothing.
#
# my-ocr holds the OCR mutex for a whole call, so this is what bounds how long
# anything else -- a CLI 'my-ocr <file>', a scan that just arrived -- waits for
# its turn. Smaller means a shorter wait and more FineReader round trips; each
# round trip costs ~25s of fixed overhead whatever the page count.
#   0 or empty = no limit (one call for everything, the old behaviour)
OCR_BATCH_MAX_PAGES=25

# Counting pages costs a pdfinfo per document (~25ms). Worth it for a queue,
# not for a backlog: above this many files 'status' reports documents only and
# leaves the page count to -V.
PAGE_COUNT_MAX_FILES=40

# osascript has no timeout of its own. The first System Events call from a new
# caller raises the Automation consent dialog ON THE CONSOLE, and osascript
# waits on it for ever -- so over ssh, or from a LaunchDaemon, setup hangs with
# no clue why. Bound it, but generously: a person may have to walk to the
# machine to click Allow.
OSASCRIPT_TIMEOUT=180              # seconds for one System Events call
# Path the generated workflow uses to call this tool. Must be stable and
# readable by the GUI user.
WORKFLOW_MY_SCAN="/LINKS/bin/my-scan"

##### EXTERNAL COMMANDS #####################################################

# my-scan hands every OCR to my-ocr, which owns FineReader, its Automator
# wiring and the mutex that keeps exactly one OCR running at a time.
MY_OCR="/LINKS/bin/my-ocr"

c_trash="/usr/local/bin/trash"
c_convert="/usr/local/bin/convert"
c_identify="/usr/local/bin/identify"
c_pdfinfo="/usr/local/bin/pdfinfo"
c_lsof="/usr/sbin/lsof"
# qpdf validates every object and stream; pdfinfo reads only the trailer,
# catalog and page tree. A delivery whose CONTENT is damaged passes pdfinfo
# and fails qpdf -- and OCRing it would waste a run and poison the queue.
c_qpdf="/opt/homebrew/bin/qpdf"
# -b -w: no blocking kernel calls, no warnings.  -n -P: no host/port lookups.
# Without these lsof can hang for minutes on an unresponsive mount.
c_lsof_opts="-b -w -n -P"

_EOCONF_
}

config_search_list() {
  _p "/LINKS/default/my-scan"
  _p "$HOME/.my-scan.conf"
  _p "/etc/my-scan.conf"
  _p "/usr/local/etc/my-scan.conf"
}

load_config() {
  CONFIG_SOURCE=

  if [ -n "$MY_SCAN_CONFIG" ]; then
    CONFIG_FILE="$MY_SCAN_CONFIG"; CONFIG_SOURCE="\$MY_SCAN_CONFIG"
  elif [ -n "$CONFIG" ]; then
    CONFIG_FILE="$CONFIG"; CONFIG_SOURCE="--config"
  else
    CONFIG_FILE=""
    _tmp="$(config_search_list)"
    while IFS= read -r _cand; do
      [ -z "$_cand" ] && continue
      if [ -r "$_cand" ]; then CONFIG_FILE="$_cand"; CONFIG_SOURCE="search"; break; fi
    done <<_EOCS_
$_tmp
_EOCS_
  fi

  if [ -z "$CONFIG_FILE" ]; then
    _p "No config file found. Searched, in order:" 1>&2
    indent "$(config_search_list)" "    > " 1>&2
    _p "" 1>&2
    _p "Create one with:  $US --create-config /LINKS/default/my-scan" 1>&2
    exit 2
  fi
  [ -r "$CONFIG_FILE" ] || err 001 "Config file '$CONFIG_FILE' is not readable."

  # POSIX '.' SEARCHES $PATH when the operand contains no slash, so a config
  # named on the command line as a bare filename would be looked for in $PATH
  # and not found. Make it unambiguously a path.
  case "$CONFIG_FILE" in */*) _cf="$CONFIG_FILE";; *) _cf="./$CONFIG_FILE";; esac
  # shellcheck disable=SC1090  # path is resolved at runtime by the search above
  . "$_cf" || err 002 "FAILED to source config file '$CONFIG_FILE'."
  dbg "config: '$CONFIG_FILE' (via $CONFIG_SOURCE)"

  [ -n "$NO_LOG" ] && LOG=""
  validate_config
  return 0
}

# A config from an older version is missing the newer keys. Unset, a numeric
# one silently turns its "while [ $i -lt $KEY ]" into a spin loop, so check
# them here rather than discovering it as a hang.
validate_config() {
  _missing=""
  for _k in SETTLE_TIMEOUT SETTLE_POLL SETTLE_STABLE_POLLS SETTLE_LSOF_TIMEOUT \
           OSASCRIPT_TIMEOUT; do
    eval "_v=\$$_k"
    if [ -z "$_v" ]; then _missing="$_missing $_k(unset)"
    elif ! isInt "$_v"; then _missing="$_missing $_k=\"$_v\"(not a number)"; fi
  done
  # SCAN_DEVICE_USUALLY_OFF is deliberately allowed to be empty (= "no")
  for _k in OCR_QUEUE_PATH T_PATH_DONE T_PATH_FAILED SETTLE_WRITER_PROCS MY_OCR; do
    # c_lsof is deliberately NOT required: empty means "autodetect", which is
    # how it works across OSes.
    eval "_v=\$$_k"
    [ -z "$_v" ] && _missing="$_missing $_k(unset)"
  done

  [ -z "$_missing" ] && return 0
  err 077 "Config '$CONFIG_FILE' is missing or malformed:$_missing
--> It was probably written for an older version. Compare it against a fresh
    default:  $US --create-config | diff - '$CONFIG_FILE'"
}

do_create_config() {
  if [ -z "$CREATE_CONFIG_FILE" ]; then
    _default_config_content
    return 0
  fi
  [ -e "$CREATE_CONFIG_FILE" ] && err 003 "Refusing to overwrite existing '$CREATE_CONFIG_FILE'."
  _default_config_content >"$CREATE_CONFIG_FILE" \
    || err 004 "FAILED to write '$CREATE_CONFIG_FILE'."
  msg "Wrote default config to '$CREATE_CONFIG_FILE'"
  det "edit it before use: DROP_PATHS and PART1_S_PATH still say CHANGEME"
  return 0
}


##############################################################################
#### VERSION

build_id() {
  _h="$(shasum -a 256 "$0" 2>/dev/null | cut -c1-12)"
  [ -z "$_h" ] && _h="unknown"
  _p "$_h"
}

do_version() {
  _bid="$(build_id)"
  if [ -n "$SCRIPT_COMMIT" ]; then
    _p "$US $SCRIPT_VERSION (commit $SCRIPT_COMMIT, build $_bid)"
  else
    _p "$US $SCRIPT_VERSION (build $_bid, unstamped)"
  fi
}

do_stamp_version() {
  _dir="$(cd "$(dirname "$0")" && pwd)" || err 005 "Cannot resolve own directory."
  git -C "$_dir" rev-parse --git-dir >/dev/null 2>&1 \
    || err 006 "Not inside a git checkout -- nothing to stamp."

  # refuse when any OTHER file is dirty: the --amend would swallow it
  _other="$(git -C "$_dir" status --porcelain -- . | grep -v " $US\$" | grep -v "/$US\$")"
  [ -n "$_other" ] && { indent "$_other" "    > " 1>&2
                        err 007 "Other files are dirty; commit or stash them first."; }

  # refuse to amend an already-published commit
  if git -C "$_dir" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    git -C "$_dir" merge-base --is-ancestor HEAD '@{upstream}' 2>/dev/null \
      && err 008 "HEAD is already pushed -- amending it would rewrite published history."
  fi

  _sha="$(git -C "$_dir" rev-parse --short HEAD)" || err 009 "git rev-parse HEAD failed."
  if [ "$SCRIPT_COMMIT" = "$_sha" ]; then
    msg "Already stamped with commit $_sha -- nothing to do."
    return 0
  fi

  _tmp="$0.stamp.$$"
  sed -e "s|^SCRIPT_COMMIT=\".*\"|SCRIPT_COMMIT=\"$_sha\"|" "$0" >"$_tmp" \
    || { rm -f "$_tmp"; err 010 "FAILED to rewrite SCRIPT_COMMIT."; }
  grep -q "^SCRIPT_COMMIT=\"$_sha\"" "$_tmp" \
    || { rm -f "$_tmp"; err 011 "SCRIPT_COMMIT line not found -- refusing to install."; }

  _mode="$(/usr/bin/stat -f '%Lp' "$0")" || _mode=750
  if ! { chmod "$_mode" "$_tmp" && mv -f "$_tmp" "$0"; }; then
    rm -f "$_tmp"; err 012 "FAILED to install."
  fi

  run git -C "$_dir" add -- "$US" || err 013 "git add failed."
  run git -C "$_dir" commit --amend --no-edit || err 014 "git commit --amend failed."

  msg "Stamped $US with commit $_sha [$(build_id)]"
  det "the stamped sha lags HEAD by one: amending changes the sha. That is expected;"
  det "do not 'fix' it. The build id above identifies these exact bytes."
  return 0
}


##############################################################################
#### SETTLE -- a file is complete and safe to pick up
##
## Three independent checks, each covering the others' blind spot:
##   1. no writer among SETTLE_WRITER_PROCS holds a write descriptor (SMB/FTP)
##   2. the size is unchanged across SETTLE_STABLE_POLLS polls
##   3. the file parses (pdfinfo / identify)

# Exact bytes, and identical on every OS. 'du' counts 512-byte blocks on BSD
# and 1024-byte blocks on GNU, so the same file appears to change size merely
# by changing machine -- which is poison for a size-stability check.
file_size() { wc -c < "$1" 2>/dev/null | tr -d ' '; }

# BSD stat and GNU stat share no flags at all for this.
file_mtime() { # -> epoch seconds
  case "$MY_OS" in
    Darwin|*BSD*) /usr/bin/stat -f %m "$1" 2>/dev/null ;;
    *)            stat -c %Y "$1" 2>/dev/null ;;
  esac
}

# lsof lives in a different place per OS, and on some minimal systems not at
# all. Never fall through silently: without it the writer check is gone and
# only size-stability and the parse check are carrying the file.
find_lsof() {
  { [ -n "$c_lsof" ] && [ -x "$c_lsof" ]; } && return 0

  # An explicitly configured path that does not work is a mistake worth
  # naming, not something to quietly paper over by finding another one.
  if [ -n "$c_lsof" ] && [ -z "$LSOF_WARNED" ]; then
    err 079 "c_lsof '$c_lsof' is not executable -- searching the usual places instead." "-"
  fi

  for _c in $SETTLE_LSOF_SEARCH; do
    [ -x "$_c" ] && c_lsof="$_c" && return 0
  done
  c_lsof="$(command -v lsof 2>/dev/null)"
  { [ -n "$c_lsof" ] && [ -x "$c_lsof" ]; } && return 0
  if [ -z "$LSOF_WARNED" ]; then
    LSOF_WARNED=1
    err 078 "lsof not found on $MY_OS -- the SMB/FTP writer check is DISABLED.
Settling now rests on size-stability and the parse check alone, which is
weaker. Install lsof, or set c_lsof in the config." "-"
  fi
  return 1
}

# shellcheck disable=SC2154  # set by the sourced config file
settle_writer_busy() { # $1 = file. 0 = a writer still holds it.
  find_lsof || return 1

  # lsof can block for minutes on an unresponsive mount, and it has no timeout
  # of its own. Unbounded here it would wedge the whole Folder Action, so run
  # it detached and kill it if it overruns. $c_lsof_opts carries -b -w -n -P:
  # no blocking kernel calls, no host or port lookups.
  _lsof_out="$(mktemp /tmp/my-scan.lsof.XXXXXX)" || return 1
  # shellcheck disable=SC2086  # a deliberate list of lsof options
  "$c_lsof" $c_lsof_opts -- "$1" >"$_lsof_out" 2>/dev/null &
  _lsof_pid=$!
  _lsof_max="$SETTLE_LSOF_TIMEOUT"
  isInt "$_lsof_max" || _lsof_max=10
  _w=0
  while kill -0 "$_lsof_pid" 2>/dev/null; do
    [ "$_w" -ge "$_lsof_max" ] && break
    sleep 1
    _w=$(( _w + 1 ))
  done
  if kill -0 "$_lsof_pid" 2>/dev/null; then
    kill -9 "$_lsof_pid" 2>/dev/null
    rm -f "$_lsof_out"
    # never silently: an unusable writer check means the size-stability and
    # parse checks are carrying this file on their own
    err 076 "lsof did not answer within ${SETTLE_LSOF_TIMEOUT}s for '$1' -- \
skipping the writer check, relying on size-stability and parse" "-"
    return 1
  fi
  wait "$_lsof_pid" 2>/dev/null

  _busy="$(awk -v procs="$SETTLE_WRITER_PROCS" '
      NR == 1 { next }
      $4 !~ /^[0-9]+[uw]$/ { next }
      { n = split(procs, p, " ");
        for (i = 1; i <= n; i++) if ($1 == p[i]) { print; next } }' "$_lsof_out")"
  rm -f "$_lsof_out"

  [ -n "$_busy" ] || return 1
  ddbg "settle: writer still holds '$1':"
  [ "$DEEPDBG" = "1" ] && indent "$_busy" "   ~ | " 1>&2
  return 0
}

# shellcheck disable=SC2154  # set by the sourced config file
settle_parses() { # $1 = file. 0 = parses as a type we accept.
  _type="$(file --brief "$1" 2>/dev/null | cut -f1 -d' ')"
  case "$_type" in
    PDF)  "$c_pdfinfo" "$1" >/dev/null 2>&1; return $? ;;
    JPEG|PNG|TIFF)
          if [ -x "$c_identify" ]; then "$c_identify" "$1" >/dev/null 2>&1; return $?
          else "$c_convert" "$1" -print '' /dev/null >/dev/null 2>&1; return $?; fi ;;
    empty)
          # not a type, an absence: 'file' says this for a zero-byte file
          ddbg "settle: '$1' is empty -- not a delivery"
          return 1 ;;
    *)    ddbg "settle: '$1' has type '$_type' -- no parser, treating as parsed"
          return 0 ;;
  esac
}

# shellcheck disable=SC2154  # set by the sourced config file
# THE three checks, in one place. Both the waiter (process) and the
# reporter (status -V) go through here, so they can never drift apart or word
# the same condition differently.
#   $1 = file, $2 = size seen on the previous look ("" if none)
# Sets SETTLE_SIZE and SETTLE_REASON; returns 0 only when all three pass.
settle_check() {
  _sc_f="$1"; _sc_prev="$2"
  if [ ! -e "$_sc_f" ]; then SETTLE_SIZE=""; SETTLE_REASON="vanished"; return 1; fi
  SETTLE_SIZE="$(file_size "$_sc_f")"

  # Zero bytes is never a delivery. A Folder Action fires when a file is
  # CREATED, not when it is complete, so an upload is regularly seen at 0
  # bytes -- and 0 is trivially "stable", so without this the size check
  # passes and an empty file sails through. Every empty and truncated file
  # in the FAILED folder was made exactly this way, by a pipeline that had
  # no settle at all.
  if [ "${SETTLE_SIZE:-0}" -eq 0 ] 2>/dev/null; then
    SETTLE_REASON="empty (0 bytes) -- nothing has been written yet"; return 1
  fi

  if settle_writer_busy "$_sc_f"; then
    SETTLE_REASON="an SMB/FTP writer still holds it"; return 1
  fi
  if [ -z "$_sc_prev" ] || [ "$_sc_prev" != "$SETTLE_SIZE" ]; then
    SETTLE_REASON="still growing (${_sc_prev:-?} -> $SETTLE_SIZE bytes)"; return 1
  fi
  if ! settle_parses "$_sc_f"; then
    SETTLE_REASON="size steady but it does not parse yet"; return 1
  fi
  SETTLE_REASON="settled"
  return 0
}

# WAIT until settled. Used by process, which must not touch a delivery
# that is still arriving.
settle_file() { # $1 = file. 0 = settled, 1 = timed out.
  _f="$1"; _i=0; _stable=0; _last=""
  dbg "settle_file('$_f'): timeout=${SETTLE_TIMEOUT}s poll=${SETTLE_POLL}s stable=${SETTLE_STABLE_POLLS}"
  vdet "waiting until no SMB/FTP writer holds it, its size stops changing, and it parses"

  while [ "$_i" -lt "$SETTLE_TIMEOUT" ]; do
    if settle_check "$_f" "$_last"; then
      # one pass is not enough: process wants the size steady for N looks
      _stable=$(( _stable + 1 ))
      if [ "$_stable" -ge "$SETTLE_STABLE_POLLS" ]; then
        vdet "settled after ${_i}s (size $SETTLE_SIZE bytes, stable ${_stable}x, parses)"
        return 0
      fi
    else
      _stable=0
      [ "$SETTLE_REASON" = "vanished" ] && return 1
    fi
    _last="$SETTLE_SIZE"
    ddbg "settle [$_i/$SETTLE_TIMEOUT] '$_f': $SETTLE_REASON"
    sleep "$SETTLE_POLL"
    _i=$(( _i + SETTLE_POLL ))
  done

  err 015 "TIMEOUT [${SETTLE_TIMEOUT}s] settling '$_f' -- $SETTLE_REASON" "-"
  return 1
}

# Why a report and not a 'settle' subcommand: "is this delivery stuck?" is a
# question about the pipeline, and status is where pipeline questions belong.
# It must never block, so it samples every file, sleeps ONCE, and re-samples --
# about a second in total however many files there are, not a second each.
settle_report() { # $1 = directory, $2 = line prefix
  _sr_dir="$1"; _sr_pfx="$2"
  [ -d "$_sr_dir" ] || return 0
  _sr_list="$(find "$_sr_dir" -mindepth 1 -maxdepth 1 -type f 2>/dev/null)"
  [ -z "$_sr_list" ] && return 0

  # REPORT only -- never waits. One sleep for the whole listing, because size
  # stability cannot be judged from a single observation.
  _sr_snap="$(mktemp /tmp/my-scan.settle.XXXXXX)" || return 0
  while IFS= read -r _sr_f; do
    [ -z "$_sr_f" ] && continue
    printf '%s\t%s\n' "$_sr_f" "$(file_size "$_sr_f")" >>"$_sr_snap"
  done <<_EOSR1_
$_sr_list
_EOSR1_

  sleep "$SETTLE_POLL"

  while IFS="$TAB" read -r _sr_f _sr_prev; do
    [ -z "$_sr_f" ] && continue
    if settle_check "$_sr_f" "$_sr_prev"; then _sr_v="settled -- ready for pickup"
    else                                      _sr_v="WAITING: $SETTLE_REASON"; fi
    _p "${_sr_pfx}| $(printf '%-34s %9s b  %s' "${_sr_f##*/}" "${SETTLE_SIZE:-0}" "$_sr_v")"
  done <<_EOSR2_
$(cat "$_sr_snap")
_EOSR2_
  rm -f "$_sr_snap"
}

settle_backup() { # $1 = file
  [ -n "$SETTLE_BACKUP_PATH" ] || return 0
  _bkp="$SETTLE_BACKUP_PATH/$(date +"%Y-%m-%d_%H%M.%S")___$$"
  mkdir -p "$_bkp" || { err 016 "FAILED to create backup dir '$_bkp'" "-"; return 1; }
  run rsync -axSH "$1" "$_bkp/" || { err 017 "FAILED to back up '$1' to '$_bkp/'" "-"; return 1; }
  vdet "kept a copy of the raw delivery in '$_bkp/'"
  return 0
}

##############################################################################
#### NAMING


determine_T_INP() { # sets T_INP from $INP / $S_INP / $T_PATH
  _inp="$INP"
  ddbg "determine_T_INP(): inp='$_inp'"

  _tmp="$(printf '%s\n' "$_inp" | sed -n 's/^\([123][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]\)_.*/\1/p')"
  if [ -n "$_tmp" ]; then
    ddbg "starts with a date ($_tmp) -- leaving the name as it is"
  else
    _tmp="$(printf '%s\n' "$_inp" | sed -n 's/^[123][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]_[0-2][0-9][0-5][0-9].[0-5][0-9]___//p')"
    if [ -n "$_tmp" ]; then
      ddbg "starts with a full timestamp -- stripping it: '$_tmp'"
      _inp="$_tmp"
    fi
    _mtime="$(file_mtime "$S_INP")"
    [ -z "$_mtime" ] && err 021 "Could not read the mtime of '$S_INP' on $MY_OS."
    _newdate="$(date -r "$_mtime" +"%Y-%m-%d_%H%M.%S")" || err 022 "date -r '$_mtime' failed."
    ddbg "mtime $_mtime -> '$_newdate'"
    _inp="${_newdate}___${_inp}"
  fi

  _base="${_inp%.*}"
  _suff="${_inp##*.}"

  # drop an ID from an earlier run, and any character that breaks the OCR app
  _base="$(printf '%s\n' "$_base" | sed -e "s|___,ID,[0-9][0-9]*$||" -e "s|[[:space:]]|_|g")"

  # No "___,ID,<pid>" any more: that existed only so part-2 could find the
  # run that part-1 had started. my-ocr owns the OCR now, so the name the
  # document is given here is the name it keeps.
  T_INP="$T_PATH/${_base}.$_suff"

  if [ -e "$T_INP" ]; then
    for _i in 1 2 3 4 5 6 7 8 9; do
      T_INP="$T_PATH/${_base}___$_i.$_suff"
      ddbg "T_INP exists -- trying '$T_INP'"
      [ ! -e "$T_INP" ] && break
    done
  fi
  [ -e "$T_INP" ] && err 023 "Unable to determine a free T_INP for '$_inp'."

  pe "  >  Determined T_INP as '$T_INP'."
}









##############################################################################
#### PROCESS -- receive a delivery and hand the OCR to my-ocr
##
## my-scan settles, names and files. my-ocr does the OCR: it owns FineReader,
## its Automator wiring and the mutex, so it BLOCKS until its turn and no
## caller has to arrange not to collide. That is why there is no lockfile, no
## part-1/part-2 split and no watchdog here any more.

# Move $S_INP to $T_PATH under its final name. Sets T_INP.
# shellcheck disable=SC2154  # set by the sourced config file
stage_file() {
  determine_T_INP || return 1
  cp "$S_INP" "$T_INP"  || { pe " >>> FAILED [$?] to cp '$S_INP' '$T_INP'";  return 1; }
  "$c_trash" "$S_INP"   || { pe " >>> FAILED [$?] to trash '$S_INP'";        return 1; }
  chmod 660 "$T_INP" 2>/dev/null
  pe "  >  '$S_INP' -> '$T_INP'"
  return 0
}

# Leftovers that nothing will ever pick up on its own, oldest first.
#   queue  = staged but never OCRed (a crashed or killed run)
#   failed = my-ocr tried and could not
# They are kept apart on purpose: a stranded file is almost always fine to
# retry, while a FAILED one already defeated the OCR once and re-feeding the
# whole folder blindly just repeats the failure. So --retry means the queue,
# and the failed ones need saying so.
retry_files() { # $1 = queue|failed|all
  # '! -name .*' matters: the queue also holds Finder droppings (.DS_Store) and
  # my-ocr's own dot-prefixed sidecars, and neither is a document to re-OCR.
  case "${1:-queue}" in
    queue|all)
      candidate_files "$OCR_QUEUE_PATH"
      ;;
  esac | sort
  case "${1:-queue}" in
    failed|all)
      candidate_files "$T_PATH_FAILED"
      ;;
  esac | sort
}

# Claiming files out of a drop folder must not happen twice at once. Two runs
# overlap for real: a backlog drain ('process --all') while a new scan fires
# its own Folder Action. Both would read the same pending list and stage the
# same document under two timestamps -- OCRed twice, one copy left stranded.
#
# The lock covers STAGING ONLY. Once a file has been moved out of the drop
# folder it is uniquely claimed, so OCR and filing need no lock here -- my-ocr's
# own mutex serialises FineReader.
stage_lock_acquire() {
  _sl_d="$OCR_QUEUE_PATH/.my-scan.staging.lock"
  _sl_i=0
  until mkdir "$_sl_d" 2>/dev/null; do
    _sl_o="$(cat "$_sl_d/owner" 2>/dev/null)"
    _sl_p="${_sl_o#pid=}"; _sl_p="${_sl_p%% *}"
    # break ONLY a provably dead owner, and never silently
    if [ -n "$_sl_p" ] && ! kill -0 "$_sl_p" 2>/dev/null; then
      pe " >>> breaking stale staging lock: owner $_sl_p is gone ($_sl_o)"
      rm -f "$_sl_d/owner"; rmdir "$_sl_d" 2>/dev/null
      continue
    fi
    _sl_i=$(( _sl_i + 1 ))
    [ "$_sl_i" -eq 1 ] && pe " >>> another '$US process' is staging (${_sl_o:-unknown}) -- waiting..."
    if [ "$_sl_i" -gt "$STAGE_LOCK_TIMEOUT" ]; then
      err 082 "TIMEOUT [${_sl_i}s] waiting for the staging lock '$_sl_d' (held by ${_sl_o:-unknown})." "-"
      return 1
    fi
    sleep 1
  done
  printf 'pid=%s at=%s\n' "$$" "$(date -u +%FT%TZ)" > "$_sl_d/owner"
  WE_HOLD_STAGE_LOCK=1
  return 0
}
stage_lock_release() {
  [ "$WE_HOLD_STAGE_LOCK" = "1" ] || return 0
  rm -f "$OCR_QUEUE_PATH/.my-scan.staging.lock/owner"
  rmdir "$OCR_QUEUE_PATH/.my-scan.staging.lock" 2>/dev/null
  WE_HOLD_STAGE_LOCK=""
  return 0
}

# Pages in one document. A picture is one page; anything we cannot read counts
# as one too -- guessing high would starve a batch, guessing zero would let an
# unbounded document slip into it.
# The cache key is size+mtime, so an edited file is recounted and an untouched
# one never is. A miss costs exactly what it used to.
page_cache_get() { # $1 = key -> pages, or nothing
  [ -n "$PAGE_CACHE" ] && [ -f "$PAGE_CACHE" ] || return 1
  _pcg="$(awk -F"$TAB" -v k="$1" '$1==k {print $2; exit}' "$PAGE_CACHE" 2>/dev/null)"
  [ -n "$_pcg" ] || return 1
  printf '%s\n' "$_pcg"
}
page_cache_put() { # $1 = key, $2 = pages
  [ -n "$PAGE_CACHE" ] || return 0
  mkdir -p "${PAGE_CACHE%/*}" 2>/dev/null || return 0
  printf '%s%s%s\n' "$1" "$TAB" "$2" >>"$PAGE_CACHE" 2>/dev/null || return 0
  # keep it bounded; the newest entries are the ones worth having
  _pcn="$(awk 'END{print NR+0}' "$PAGE_CACHE" 2>/dev/null)"
  _pcm="$PAGE_CACHE_MAX"; isInt "$_pcm" || _pcm=5000
  if [ "$_pcn" -gt "$_pcm" ]; then
    tail -n "$(( _pcm / 2 ))" "$PAGE_CACHE" >"$PAGE_CACHE.new" 2>/dev/null \
      && mv -f "$PAGE_CACHE.new" "$PAGE_CACHE" 2>/dev/null
  fi
  return 0
}

page_count() { # $1 = file
  _pk="$(file_size "$1"):$(file_mtime "$1"):$1"
  _pc="$(page_cache_get "$_pk")" && { printf '%s\n' "$_pc"; return 0; }
  case "$(file --brief "$1" 2>/dev/null | cut -f1 -d' ')" in
    PDF)
      _pc="$("$c_pdfinfo" "$1" 2>/dev/null | awk '/^Pages:/{print $2; exit}')"
      case "$_pc" in ''|*[!0-9]*) _pc=1 ;; esac ;;
    *) _pc=1 ;;
  esac
  page_cache_put "$_pk" "$_pc"
  printf '%s\n' "$_pc"
}

# The deep structural check, run once per delivery after it has settled.
# qpdf grades its exit: 0 = clean, 3 = warnings only, 2 = real damage. Reading
# any non-zero as damage would quarantine healthy documents over cosmetic
# warnings, which plenty of real PDFs carry.
deep_check_ok() { # $1 = file. 0 = usable, 1 = damaged
  DEEP_CHECK_WHY=""
  case "$(file --brief "$1" 2>/dev/null | cut -f1 -d' ')" in
    PDF) ;;
    *) return 0 ;;                       # pictures have no structure to check
  esac
  if [ -z "$c_qpdf" ] || [ ! -x "$c_qpdf" ]; then
    DEEP_CHECK_WHY=""
    vdet "no qpdf -- skipping the deep structural check"
    return 0
  fi
  "$c_qpdf" --check "$1" >/dev/null 2>&1
  case "$?" in
    0) return 0 ;;
    3) vdet "qpdf reports warnings (not damage) for '${1##*/}'"; return 0 ;;
    *) DEEP_CHECK_WHY="qpdf reports damaged objects or streams"; return 1 ;;
  esac
}

# Is this name one we never treat as a document?
is_ignored_name() { # $1 = path
  _in_b="${1##*/}"
  for _in_p in $IGNORE_FILENAME_PATTERNS; do
    # shellcheck disable=SC2254  # config-supplied globs, deliberately unquoted
    case "$_in_b" in $_in_p) return 0 ;; esac
  done
  return 1
}

# Every file in a folder that IS a candidate document. One definition, used by
# everything that walks a folder -- counting one set and processing another is
# how ".ftpquota" reached settle and how "10 documents / 9 pages" was printed.
candidate_files() { # $1 = dir
  [ -d "$1" ] || return 0
  find "$1" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | while IFS= read -r _cf_f; do
    [ -n "$_cf_f" ] || continue
    is_ignored_name "$_cf_f" || printf '%s\n' "$_cf_f"
  done
}

# Under -V, one line per file: what it is, how many pages, what it is called.
# A summary says "4 BROKEN"; this says WHICH four, which is what you need to
# decide whether to rescan them.
queue_detail() { # $1 = dir, $2 = line prefix
  [ "$VRB" = "1" ] || return 0
  [ -d "$1" ] || return 0
  # keep the prefix OUT of $2: 'set --' below overwrites the positionals
  _qd_pfx="$2"
  candidate_files "$1" | sort | while IFS= read -r _qd_f; do
    [ -n "$_qd_f" ] || continue
    # shellcheck disable=SC2046  # deliberate: "ok <pages>" splits into $1 $2
    set -- $(classify_file "$_qd_f")
    case "$1" in
      ok)     _p "${_qd_pfx}          | ok     $(printf '%5s' "${2:-?}")p  ${_qd_f##*/}" ;;
      broken) _p "${_qd_pfx}          | BROKEN      -  ${_qd_f##*/}" ;;
      empty)  _p "${_qd_pfx}          | EMPTY       -  ${_qd_f##*/}" ;;
      *)      _p "${_qd_pfx}          | other       -  ${_qd_f##*/}" ;;
    esac
  done
  return 0
}

# What IS this file? "failed" lumps together things that need different
# answers: an empty file is a delivery that never arrived, a broken one is a
# damaged document, and a Finder dropping is not a document at all.
#   ok <pages> | broken | empty | other
classify_file() { # $1 = file
  [ -e "$1" ] || { printf 'other\n'; return 0; }
  case "${1##*/}" in .*) printf 'other\n'; return 0 ;; esac   # .DS_Store, sidecars
  [ -s "$1" ] || { printf 'empty\n'; return 0; }
  case "$(file --brief "$1" 2>/dev/null | cut -f1 -d' ')" in
    PDF)
      _cf_p="$("$c_pdfinfo" "$1" 2>/dev/null | awk '/^Pages:/{print $2; exit}')"
      case "$_cf_p" in
        ''|*[!0-9]*|0) printf 'broken\n' ;;                   # pdfinfo cannot read it
        *)             printf 'ok %s\n' "$_cf_p" ;;
      esac ;;
    JPEG|PNG|TIFF) printf 'ok 1\n' ;;                         # a picture is one page
    *)             printf 'other\n' ;;
  esac
}

# A directory in one line. Counting and summing MUST walk the same set of
# files -- counting everything while summing only some is how "10 documents /
# 9 pages" happened, an arithmetic impossibility printed with a straight face.
count_docs_pages() { # $1 = dir
  _cdp_n="$(count_files "$1")"
  if [ "$_cdp_n" = "0" ]; then printf 'empty\n'; return 0; fi
  _lim="$PAGE_COUNT_MAX_FILES"; isInt "$_lim" || _lim=40
  if [ "$_cdp_n" -gt "$_lim" ] && [ "$VRB" != "1" ]; then
    printf '%s files (-V looks at them)\n' "$_cdp_n"; return 0
  fi
  _cdp_ok=0; _cdp_p=0; _cdp_br=0; _cdp_em=0; _cdp_ot=0
  _cdp_t="$(mktemp /tmp/my-scan.pages.XXXXXX)" || { printf '%s files\n' "$_cdp_n"; return 0; }
  candidate_files "$1" >"$_cdp_t"
  while IFS= read -r _cdp_f; do
    [ -n "$_cdp_f" ] || continue
    # shellcheck disable=SC2046  # deliberate: "ok <pages>" splits into $1 $2
    set -- $(classify_file "$_cdp_f")
    case "$1" in
      ok)     _cdp_ok=$(( _cdp_ok + 1 )); _cdp_p=$(( _cdp_p + ${2:-1} )) ;;
      broken) _cdp_br=$(( _cdp_br + 1 )) ;;
      empty)  _cdp_em=$(( _cdp_em + 1 )) ;;
      *)      _cdp_ot=$(( _cdp_ot + 1 )) ;;
    esac
  done <"$_cdp_t"
  rm -f "$_cdp_t"
  # the clean case stays clean; the rest is only named when it exists
  _cdp_s="$_cdp_ok document(s) / $_cdp_p page(s)"
  [ "$_cdp_br" -gt 0 ] && _cdp_s="$_cdp_s, $_cdp_br BROKEN"
  [ "$_cdp_em" -gt 0 ] && _cdp_s="$_cdp_s, $_cdp_em EMPTY"
  [ "$_cdp_ot" -gt 0 ] && _cdp_s="$_cdp_s, $_cdp_ot not a document"
  printf '%s\n' "$_cdp_s"
}

# Everything sitting in a drop folder, oldest first -- that is the order they
# were scanned in, and the order you would want them OCRed.
pending_files() {
  for _pd in $DROP_PATHS; do
    [ -d "$_pd" ] || continue
    candidate_files "$_pd"
  done | sort
}

# my-ocr replaces each original IN PLACE on success and moves what it could not
# OCR to T_PATH_FAILED. So whatever is still in the list now is an OCRed file,
# ready to be filed. Shared by 'process' and 'process --retry' so the two
# cannot drift apart.
# The '_fr_' prefix is not decoration: this runs INSIDE ocr_in_chunks' own
# read loop, and a shared variable name here silently ate a document from the
# next chunk -- the loop appended a value this function had overwritten.
file_ocred_results() { # $1 = newline-separated staged paths
  while IFS= read -r _fr_f; do
    [ -z "$_fr_f" ] && continue
    [ -e "$_fr_f" ] || continue                    # my-ocr moved it out
    _fr_final="$T_PATH_DONE/${_fr_f##*/}"
    if [ -e "$_fr_final" ]; then
      _fr_final="$T_PATH_DONE/$(date +%Y-%m-%d_%H%M.%S)___${_fr_f##*/}"
    fi
    if mv "$_fr_f" "$_fr_final"; then
      FILES_OCRED_CNT=$(( FILES_OCRED_CNT + 1 ))
      pe "  >  filed '$_fr_final'"
    else
      err 070 "FAILED [$?] to file '$_fr_f' -> '$_fr_final'" "-"
    fi
  done <<_EOFI_
$1
_EOFI_
  return 0
}

# Hand files to my-ocr in chunks of at most OCR_BATCH_MAX_PAGES pages.
#
# my-ocr holds the OCR mutex for the whole call, so one unbounded call means
# anything else waits for the entire backlog. Chunking releases the mutex
# between chunks, which is what bounds that wait. A document larger than the
# cap still goes on its own -- never starved, just alone.
ocr_in_chunks() { # $1 = newline-separated staged paths
  _cap="$OCR_BATCH_MAX_PAGES"
  isInt "$_cap" || _cap=0
  _chunk=""; _chunk_pages=0; _chunk_no=0
  _oc_t="$(mktemp /tmp/my-scan.chunk.XXXXXX)" || { _chunk="$1"; ocr_one_chunk; return 0; }
  printf '%s\n' "$1" >"$_oc_t"
  while IFS= read -r _oc_f; do
    [ -n "$_oc_f" ] || continue
    _fp=1
    [ "$_cap" -gt 0 ] && _fp="$(page_count "$_oc_f")"
    # flush first when this file would push us over -- but never emit an
    # empty chunk, so an oversized document still gets its own run
    if [ "$_cap" -gt 0 ] && [ -n "$_chunk" ] \
       && [ $(( _chunk_pages + _fp )) -gt "$_cap" ]; then
      ocr_one_chunk
      _chunk=""; _chunk_pages=0
    fi
    _chunk="${_chunk}${_chunk:+$NL}$_oc_f"
    _chunk_pages=$(( _chunk_pages + _fp ))
  done <"$_oc_t"
  rm -f "$_oc_t"
  [ -n "$_chunk" ] && ocr_one_chunk
  return 0
}

ocr_one_chunk() {
  _chunk_no=$(( _chunk_no + 1 ))
  _cn="$(printf '%s\n' "$_chunk" | awk 'NF{n++} END{print n+0}')"
  if [ "$_cap" -gt 0 ]; then
    pe "  >  chunk $_chunk_no: $_cn file(s), $_chunk_pages page(s) (cap $_cap)"
  fi
  set -- "$MY_OCR" --move-failed-to "$T_PATH_FAILED"
  while IFS= read -r _cf; do [ -n "$_cf" ] && set -- "$@" "$_cf"; done <<_EOCH_
$_chunk
_EOCH_
  if "$@"; then
    pe "  >  $MY_OCR finished [0]"
  else
    err 069 "$MY_OCR failed [$?] -- see its own log; files it could not OCR are in '$T_PATH_FAILED'." "-"
  fi
  file_ocred_results "$_chunk"
  return 0
}

# The counterpart of --retry: --retry re-feeds what MIGHT work, --cleanup
# discards what provably cannot. A 0-byte or unparseable file holds no
# document -- the bytes never arrived and cannot be reconstructed here, so
# keeping it only makes the FAILED count lie about how much is really wrong.
#
# It goes to the TRASH, never rm: "provably unrecoverable" is still my
# judgement, and you get to disagree with it.
do_cleanup_unrecoverable() {
  _cu_dirs="$T_PATH_FAILED $OCR_QUEUE_PATH"
  _cu_t="$(mktemp /tmp/my-scan.cleanup.XXXXXX)" || err 071 "mktemp failed."
  for _cu_d in $_cu_dirs; do
    [ -d "$_cu_d" ] || continue
    candidate_files "$_cu_d" | sort | while IFS= read -r _cu_f; do
      [ -n "$_cu_f" ] || continue
      # shellcheck disable=SC2046  # deliberate: "ok <pages>" splits into $1 $2
      set -- $(classify_file "$_cu_f")
      case "$1" in
        empty|broken) printf '%s%s%s\n' "$1" "$TAB" "$_cu_f" ;;
      esac
    done
  done >"$_cu_t"

  _cu_n="$(awk 'NF{n++} END{print n+0}' "$_cu_t")"
  if [ "$_cu_n" -eq 0 ]; then
    _p " >>> nothing unrecoverable -- every file in the queues holds a document."
    rm -f "$_cu_t"; return 0
  fi

  _p " >>> $_cu_n file(s) hold no recoverable document:"
  while IFS="$TAB" read -r _cu_w _cu_f; do
    [ -n "$_cu_f" ] || continue
    _p "     $(printf '%-7s' "$_cu_w")  ${_cu_f##*/}"
  done <"$_cu_t"
  _p ""
  _p "     EMPTY  = 0 bytes: the upload never delivered anything"
  _p "     BROKEN = truncated or unparseable: the upload stopped part-way"
  _p "     Neither can be recovered here. The document must be SCANNED AGAIN."

  if [ -z "$PROCESS_CLEANUP_GO" ]; then
    _p ""
    _p " >>> nothing removed -- this was a dry run. To move them to the Trash:"
    _p "     $US process --cleanup go"
    rm -f "$_cu_t"; return 0
  fi

  [ -x "$c_trash" ] || { rm -f "$_cu_t"; err 083 "NOT FOUND: '$c_trash' -- refusing to delete outright."; }
  _cu_done=0
  while IFS="$TAB" read -r _cu_w _cu_f; do
    [ -n "$_cu_f" ] || continue
    if "$c_trash" -- "$_cu_f" >/dev/null 2>&1; then
      _cu_done=$(( _cu_done + 1 )); _p "     trashed ($_cu_w)  ${_cu_f##*/}"
    else
      _p "     FAILED to trash  ${_cu_f##*/}"
    fi
  done <"$_cu_t"
  rm -f "$_cu_t"
  _p ""
  _p " >>> $_cu_done file(s) moved to the Trash -- recoverable there if I judged wrong [0]"
  return 0
}

# Retry: the files are already staged and named, so this is my-ocr plus the
# filing step -- no settle, no rename. Anything my-ocr still cannot do lands
# back in FAILED, so a retry can be repeated without making a mess.
do_retry_batch() {
  _rb_n="$(printf '%s\n' "$INP_FILES" | awk 'NF{n++} END{print n+0}')"
  pe " >>> RETRY: handing $_rb_n file(s) back to my-ocr"
  mkdir -p "$OCR_QUEUE_PATH" 2>/dev/null
  # move FAILED ones back into the queue first: that is where my-ocr's caller
  # contract says work lives, and it keeps one code path for both sources.
  _rb_list=""
  printf '%s\n' "$INP_FILES" | while IFS= read -r _rf; do
    [ -n "$_rf" ] || continue
    case "$_rf" in
      "$T_PATH_FAILED"/*)
        _rt="$OCR_QUEUE_PATH/${_rf##*/}"
        if mv "$_rf" "$_rt" 2>/dev/null; then pe "  >  requeued '${_rf##*/}'"
        else pe "  >  FAILED to requeue '${_rf##*/}'"; fi ;;
    esac
  done
  # re-read: the moves above happened in a subshell
  INP_FILES="$(retry_files queue)"
  _rb_list="$INP_FILES"
  [ -z "$_rb_list" ] && { pe " >>> nothing left to retry."; return 0; }

  ocr_in_chunks "$_rb_list"
  pe ""
  pe "$(date +"%Y-%m-%d_%H%M.%S") RETRY DONE -- $FILES_OCRED_CNT filed."
  return 0
}

do_process() {
  [ -x "$c_trash" ]   || err 064 "NOT FOUND: '$c_trash' (brew install trash)"
  [ -x "$c_pdfinfo" ] || err 066 "NOT FOUND: '$c_pdfinfo' (brew install poppler)"
  [ -x "$MY_OCR" ]    || err 067 "NOT FOUND: '$MY_OCR' -- my-scan hands every OCR to it."

  # The LOG redirect happens only once we are actually going to DO something.
  # A listing is a question the user asked at a terminal; answering it into a
  # logfile they cannot see is the same as not answering.
  process_start_log() {
    if [ -n "$LOG" ]; then
      mkdir -p "${LOG%/*}" 2>/dev/null
      exec 3<&1 && exec 1>>"$LOG" && exec 2>&1
      LOG_IS_STDERR=1
    else
      exec 3<&1
    fi
    NOW="$(date +"%Y-%m-%d_%H%M.%S")"
    echo; pe ""
  }

  # Three ways in:
  #   --all        -> everything pending in the drop folders (backlog recovery)
  #   stdin        -> exactly those files (what the Folder Action pipes in)
  #   neither      -> LIST what is pending and change nothing, so 'process'
  #                   on its own is a question, never an accident
  if [ -n "$PROCESS_CLEANUP" ]; then
    do_cleanup_unrecoverable
    exit $?
  fi

  if [ -n "$PROCESS_RETRY" ]; then
    [ -n "$PROCESS_ALL" ] && process_start_log
    # A file here is already settled, named and staged, so it goes straight to
    # my-ocr -- re-settling a file my-scan itself placed would be nonsense.
    INP_FILES="$(retry_files "$PROCESS_RETRY")"
    if [ -z "$INP_FILES" ]; then
      pe " >>> nothing to retry ($PROCESS_RETRY)."
      exit 0
    fi
    if [ -z "$PROCESS_ALL" ]; then
      pe " >>> RETRY -- these would be handed to my-ocr again ($PROCESS_RETRY):"
      printf '%s\n' "$INP_FILES" | while IFS= read -r _rf; do
        [ -n "$_rf" ] && pe "  >  ${_rf##*/}"
      done
      case "$PROCESS_RETRY" in
        queue) _rh="";;
        *)     _rh=" $PROCESS_RETRY";;
      esac
      pe " >>> nothing done -- add --all to retry them:  $US process --retry$_rh --all"
      exit 0
    fi
    do_retry_batch
    exit $?
  fi

  # Decide the mode BEFORE the log redirect: with no work to do this is a
  # listing, and a listing must answer on the terminal.
  # claim under the lock, so two runs cannot take the same document
  mkdir -p "$OCR_QUEUE_PATH" 2>/dev/null
  stage_lock_acquire || return 1
  if [ -n "$PROCESS_ALL" ]; then
    INP_FILES="$(pending_files)"
  else
    INP_FILES="$(collect_inputs)"
  fi
  [ -z "$INP_FILES" ] && stage_lock_release

  if [ -n "$INP_FILES" ]; then
    process_start_log
  fi

  if [ -n "$PROCESS_ALL" ]; then
    [ -z "$INP_FILES" ] && { _p "Nothing pending in: $DROP_PATHS"; return 0; }
    pe "--all: taking everything pending"
  else
    if [ -z "$INP_FILES" ]; then
      _pend="$(pending_files)"
      if [ -z "$_pend" ]; then
        pe "Nothing pending in: $DROP_PATHS"
      else
        _pn="$(printf '%s\n' "$_pend" | wc -l | tr -d ' ')"
        pe "$_pn file(s) pending:"
        printf '%s\n' "$_pend" | while IFS= read -r _pf; do
          [ -n "$_pf" ] && pe "  | ${_pf##*/}"
        done
        pe ""
        pe "nothing processed -- '$US process --all' to take them all,"
        pe "or pipe a subset:  ls -1d <dir>/* | head -10 | $US process"
        pe "'$US -V status' says why a file is not settled yet."
      fi
      # no log was opened for a listing, so there is nothing to unwind
      return 0
    fi
  fi
  INP_FILES_CNT="$(printf '%s\n' "$INP_FILES" | wc -l | tr -d ' ')"
  pe "$NOW Got $INP_FILES_CNT file(s)."

  T_PATH="$OCR_QUEUE_PATH"
  mkdir -p "$T_PATH" "$T_PATH_DONE" "$T_PATH_FAILED" 2>/dev/null

  _staged=""          # files handed to my-ocr
  _skipped=""         # marked no-ocr: filed as they are

  while IFS= read -r S_INP; do
    [ -z "$S_INP" ] && continue
    pe ""
    pe " >>> '$S_INP'"
    [ -e "$S_INP" ] || { err 026 "File '$S_INP' not found." "-"; continue; }

    INP="${S_INP##*/}"

    # 1. SETTLE -- the delivery may still be arriving over SMB or FTP
    if ! settle_file "$S_INP"; then
      FAILED_CNT=$(( FAILED_CNT + 1 ))
      T_PATH="$T_PATH_FAILED"; stage_file
      T_PATH="$OCR_QUEUE_PATH"
      notify_bad_delivery "$S_INP" "incomplete -- it never settled within ${SETTLE_TIMEOUT}s (${SETTLE_REASON:-unknown})"
      err 028 "'$S_INP' never settled within ${SETTLE_TIMEOUT}s -- filed under FAILED." "-"
      continue
    fi
    pe "  >  settled ($(file_size "$S_INP") bytes) [0]"

    # ONCE, now that the file has stopped changing -- 0.3s per document, and
    # far too expensive to run inside settle's poll loop. This is the strong
    # structural check: settle's parse test only proves pdfinfo can read the
    # catalogue, not that the page content survived the transfer.
    if ! deep_check_ok "$S_INP"; then
      FAILED_CNT=$(( FAILED_CNT + 1 ))
      T_PATH="$T_PATH_FAILED"; stage_file
      T_PATH="$OCR_QUEUE_PATH"
      notify_bad_delivery "$S_INP" "structurally damaged -- $DEEP_CHECK_WHY"
      err 084 "'$S_INP' is structurally damaged ($DEEP_CHECK_WHY) -- filed under FAILED." "-"
      continue
    fi
    settle_backup "$S_INP"

    # 2. A light type check only. my-ocr does the deep validation -- it skips
    #    already-OCRed and encrypted files itself, and knows more about them
    #    than my-scan should.
    INP_FILE_TYPE="$(file --brief "$S_INP")"
    if printf '%s\n' "$INP_FILE_TYPE" | grep -qv "^$ACCEPT_FILE_TYPE_REGEX"; then
      WRONG_FILETYPE_CNT=$(( WRONG_FILETYPE_CNT + 1 ))
      FAILED_CNT=$(( FAILED_CNT + 1 ))
      T_PATH="$T_PATH_FAILED"; stage_file
      T_PATH="$OCR_QUEUE_PATH"
      case "$INP_FILE_TYPE" in
        empty*) notify_bad_delivery "$S_INP" "EMPTY (0 bytes)" ;;
        *)      notify_bad_delivery "$S_INP" "unreadable -- '$INP_FILE_TYPE', not a document my-ocr can OCR" ;;
      esac
      err 030 "Unexpected file type '$INP_FILE_TYPE' -- filed under FAILED." "-"
      continue
    fi
    pe "  >  type '$INP_FILE_TYPE' PASSED"

    # 3. A marked file is filed as it is: we simply do not call my-ocr for it.
    _no_ocr=""
    for _pat in $NO_OCR_PATTERNS; do
      # shellcheck disable=SC2254  # a config-supplied glob, deliberately
      case "$INP" in $_pat) _no_ocr=1;; esac
    done
    if [ -n "$_no_ocr" ]; then
      IGNORED_CNT=$(( IGNORED_CNT + 1 ))
      T_PATH="$T_PATH_DONE"; stage_file
      T_PATH="$OCR_QUEUE_PATH"
      pe "  >  matches NO_OCR_PATTERNS -- filed without OCR."
      continue
    fi

    # 4. Name it and move it into the OCR queue.
    if stage_file; then
      _staged="${_staged}${_staged:+$NL}$T_INP"
    else
      FAILED_CNT=$(( FAILED_CNT + 1 ))
    fi
  done <<_EOPI_
$INP_FILES
_EOPI_

  stage_lock_release   # everything is claimed; OCR needs no staging lock

  # ---- hand the batch to my-ocr, in page-bounded chunks --------------------
  if [ -n "$_staged" ]; then
    _n="$(printf '%s\n' "$_staged" | wc -l | tr -d ' ')"
    pe ""
    pe " >>> Handing $_n file(s) to $MY_OCR"
    pe "     It blocks until it is our turn -- one FineReader run exists at a"
    pe "     time, and my-ocr is what guarantees that."
    pe "     Anything it cannot OCR goes to '$T_PATH_FAILED' (--move-failed-to)."
    ocr_in_chunks "$_staged"
  fi

  pe ""
  _pfx="$LOGPFX|>RESULT<| "
  printf "%sGot %4d file(s):\n"                 "$_pfx" "$INP_FILES_CNT"
  printf "%s  > %4d OCRed and filed.\n"         "$_pfx" "$FILES_OCRED_CNT"
  printf "%s  > %4d filed without OCR.\n"       "$_pfx" "$IGNORED_CNT"
  printf "%s  > %4d failed (of which %d wrong file type).\n" \
                                                "$_pfx" "$FAILED_CNT" "$WRONG_FILETYPE_CNT"

  pe ""
  pe "$(date +"%Y-%m-%d_%H%M.%S") DONE."
  [ -n "$LOG" ] && exec 1<&3 && exec 3<&- && REDIRECT_TO_LOG=1
  return 0
}

##############################################################################
#### OCR APPLICATION CONTROL




##############################################################################
#### INPUT COLLECTION (argv, else stdin)

# Only 'process' feeds this now, and Automator always pipes: the argv branch
# left with the 'settle' subcommand.
collect_inputs() {
  [ -t 0 ] && return 0
  cat
}


##############################################################################
#### SCAN -- pull-scan from the device (was: the whole of the old my-scan)

scan_backend() {
  if [ -n "$c_scanimage" ] && [ -x "$c_scanimage" ]; then _p "scanimage"; return 0; fi
  command -v scanimage  >/dev/null 2>&1 && { _p "scanimage";  return 0; }
  command -v epsonscan2 >/dev/null 2>&1 && { _p "epsonscan2"; return 0; }
  case "$SCAN_DEVICE" in
    http://*|https://*|esclnet:*) _p "escl"; return 0 ;;
  esac
  _p ""
  return 1
}

scan_device_host() { # the host/ip part of SCAN_DEVICE, or "" if it has none
  case "$SCAN_DEVICE" in
    *:net:*)       printf '%s\n' "${SCAN_DEVICE##*:net:}" ;;
    http://*|https://*)
                   _h="${SCAN_DEVICE#*://}"; _h="${_h%%/*}"; printf '%s\n' "${_h%%:*}" ;;
    *)             _p "" ;;
  esac
}

do_devices() {
  msg "Looking for scanners"
  _found=0

  _be="$(scan_backend)"
  vdet "backend that would be used for a scan: ${_be:-<none installed>}"

  if command -v scanimage >/dev/null 2>&1; then
    vrb "scanimage -L"
    vdet "asks every installed SANE backend what it can see"
    _out="$(scanimage -L 2>&1)"
    indent "$_out" "    > "
    printf '%s\n' "$_out" | grep -q "^device" && _found=1
  else
    det "scanimage is not installed -- skipping the SANE query"
  fi

  if command -v ippfind >/dev/null 2>&1; then
    vrb "ippfind -T 10 _uscan._tcp -p"
    vdet "browses mDNS for driverless (eSCL/AirScan) scanners on this LAN"
    _out="$(ippfind -T 10 _uscan._tcp -p 2>&1)"
    if [ -n "$_out" ]; then indent "$_out" "    > "; _found=1
    else det "no _uscan._tcp responder on this LAN"; fi
  fi

  _host="$(scan_device_host)"
  if [ -n "$_host" ]; then
    if ping -c1 -t2 "$_host" >/dev/null 2>&1; then
      det "configured device '$SCAN_DEVICE_NAME' at $_host is reachable [0]"
      _found=1
    else
      det "configured device '$SCAN_DEVICE_NAME' at $_host is NOT reachable [$?]"
    fi
  else
    det "SCAN_DEVICE '$SCAN_DEVICE' carries no host -- nothing to ping"
  fi

  [ "$_found" = "1" ] || msg "Found no scanner. Is it powered on and on this subnet?"
  return 0
}

scan_once() { # runs one scan; sets SCAN_CMDSTR; returns the backend's rc
  # shellcheck disable=SC2086  # a deliberate list of scanner options
  set -- scanimage --device-name "$SCAN_DEVICE" $SCAN_OPTS --source "$SCAN_SOURCE"
  [ -n "$SCAN_BATCH_FILENAME" ] && set -- "$@" "--batch=$SCAN_BATCH_FILENAME"
  SCAN_CMDSTR="$*"
  [ "$VRB" = "1" ] && _p " >>> $SCAN_CMDSTR"
  "$@"
  _rc=$?
  ddbg "scan_once(): rc=$_rc"
  return $_rc
}

do_scan() {
  # Only the scanimage backend is implemented; scan_backend() recognises escl
  # and epsonscan2 but scan_once() drives scanimage. Say which of those two
  # cases this is rather than blaming the device string for either.
  _be="$(scan_backend)"
  case "$_be" in
    scanimage) : ;;
    "")        err 048 "No scan backend at all: 'scanimage' is not installed and SCAN_DEVICE '$SCAN_DEVICE' names no recognised backend. Install one with 'brew install sane-backends', then '$US devices'." ;;
    *)         err 048 "SCAN_DEVICE '$SCAN_DEVICE' selects the '$_be' backend, which is not implemented yet -- only 'scanimage' is. Install it with 'brew install sane-backends'." ;;
  esac

  if [ -n "$1" ]; then fn="$1"; shift; else fn="$SCAN_DEFAULT_FNAME"; fi
  full_fn="$SCAN_OUT_PATH/$fn"

  NOW_FN="$(date +'%Y-%m-%d_%H%M.%S')"
  TEMPFILE_PREFIX=".scan-out_${NOW_FN}_"
  SCAN_BATCH_FILENAME="${TEMPFILE_PREFIX}%d.$SCAN_FORMAT"
  SCAN_OPTS="$SCAN_DEFAULT_OPTS --mode $SCAN_MODE --resolution ${SCAN_DPI}dpi $*"

  cd "$SCAN_OUT_PATH" || err 049 "Cannot cd to SCAN_OUT_PATH '$SCAN_OUT_PATH'."

  msg "Scanning '$SCAN_DEVICE_NAME' to '$fn' in '$SCAN_OUT_PATH'"
  det "options: $SCAN_OPTS"

  if [ -n "$DUPLEX" ]; then
    SCAN_SOURCE="Duplex"
    det "expecting a DUPLEX document in the feeder"
  else
    SCAN_SOURCE="ADF"
    det "trying the document feeder first"
  fi

  if [ -n "$WAIT_FOR_ADF" ]; then
    rc=7
    while [ "$rc" -eq 7 ]; do
      det "waiting for a document in the feeder..."
      scan_once; rc=$?
      [ "$rc" -eq 7 ] && sleep 2
    done
  else
    scan_once; rc=$?
    if [ "$rc" -eq 7 ]; then
      SCAN_SOURCE="Flatbed"
      det "feeder is empty [7] -- scanning from the flatbed instead"
      scan_once; rc=$?
    fi
  fi

  [ "$rc" -ne 4 ] && [ "$rc" -ne 0 ] \
    && err 050 "Scan failed [$rc]: $SCAN_CMDSTR  (pwd '$(pwd)')"

  msg2 "Assembling the pages into '$fn'"
  run "$c_convert" "$SCAN_OUT_PATH/$TEMPFILE_PREFIX"* "$full_fn" \
    || err 051 "FAILED to assemble '$SCAN_OUT_PATH/$TEMPFILE_PREFIX'* into '$full_fn'."

  scan_cleanup

  if [ -n "$SCAN_VIEWER_CMD" ]; then
    # deliberately word-split: it is a command WITH arguments ("open -a Preview")
    # shellcheck disable=SC2086
    run $SCAN_VIEWER_CMD "$full_fn" \
      || err 052 "FAILED [$?] to open '$full_fn' with '$SCAN_VIEWER_CMD'." "-"
  else
    vdet "SCAN_VIEWER_CMD is empty -- not opening '$full_fn'"
  fi

  msg "done :)  '$full_fn' ($(file_size "$full_fn") bytes) [0]"
  return 0
}

scan_cleanup() {
  [ -n "$CLEANUP_DONE" ] && return 0
  CLEANUP_DONE=1
  [ -z "$TEMPFILE_PREFIX" ] && return 0
  if [ "$DBG" = "1" ]; then
    dbg "keeping the temp files (debug mode):"
    find "$SCAN_OUT_PATH" -maxdepth 1 -name "$TEMPFILE_PREFIX*" 2>/dev/null | sed -e "s|^|   ~ |" 1>&2
    return 0
  fi
  _tmp="$(ls "$SCAN_OUT_PATH/$TEMPFILE_PREFIX"* 2>/dev/null)"
  [ -z "$_tmp" ] && return 0
  while IFS= read -r _f; do
    [ -z "$_f" ] && continue
    rm -f "$_f" || det "FAILED to remove '$_f'"
  done <<_EOCL_
$_tmp
_EOCL_
  return 0
}


##############################################################################
#### STATUS

count_files() { # $1 = dir -> number of plain files in it, "-" if missing
  [ -d "$1" ] || { _p "-"; return 1; }
  candidate_files "$1" | wc -l | tr -d ' '
}

running_pids() {
  pgrep -f "$US " 2>/dev/null | grep -v "^$$\$" | xargs echo
}


folder_action_state() {
  _plist="$HOME/Library/Preferences/com.apple.FolderActionsDispatcher.plist"
  [ -f "$_plist" ] || { _p "no folder-action preferences file"; return 1; }
  _enabled="$(/usr/libexec/PlistBuddy -c "Print :folderActionsEnabled" "$_plist" 2>/dev/null)"
  [ -z "$_enabled" ] && _enabled="unknown"
  # the bindings are NSKeyedArchiver blobs; the folder and workflow names are
  # still readable as plain strings inside them
  _names="$(strings "$_plist" 2>/dev/null \
             | grep -E "^[A-Za-z0-9][A-Za-z0-9._+-]*\.workflow\$" | sort -u | xargs echo)"
  _p "enabled=$_enabled workflows=${_names:-<none>}"
}

# One line per thing that exists right now: "<state><TAB><path>". cancel_list
# is the single source of truth for what is IN FLIGHT; the two destination
# folders are added here because landing there is the whole point of watching.
watch_snapshot() {
  cancel_list
  [ -d "$T_PATH_DONE" ] && find "$T_PATH_DONE" -mindepth 1 -maxdepth 1 -type f 2>/dev/null \
    | while IFS= read -r _f; do [ -n "$_f" ] && printf 'filed\t%s\n' "$_f"; done
  [ -d "$T_PATH_FAILED" ] && find "$T_PATH_FAILED" -mindepth 1 -maxdepth 1 -type f 2>/dev/null \
    | while IFS= read -r _f; do [ -n "$_f" ] && printf 'FAILED\t%s\n' "$_f"; done
  return 0
}

# A live view that RECORDS changes instead of repainting. A repaint loop
# destroys the scrollback, which is exactly the history you are watching for,
# and a file that moves between two polls would leave no trace at all.
do_watch_status() {
  # my-ocr is only consulted when the OCR queue is non-empty -- that is the
  # only time the answer can differ, and it is a process spawn per poll.
  OCR_STATE="queued for OCR"
  _ws_prev="$(mktemp /tmp/my-scan.w1.XXXXXX)" || err 071 "mktemp failed."
  _ws_cur="$(mktemp /tmp/my-scan.w2.XXXXXX)"  || err 071 "mktemp failed."
  # shellcheck disable=SC2064  # expand the paths now, not at trap time
  trap "rm -f '$_ws_prev' '$_ws_cur'; echo; exit 0" INT TERM HUP

  if ! isNum "$WATCH_INTERVAL"; then
    WATCH_INTERVAL=1
    vdet "WATCH_INTERVAL is unset in $CONFIG_FILE -- using ${WATCH_INTERVAL}s"
  fi

  do_status ""
  echo
  msg "watching every ${WATCH_INTERVAL}s -- Ctrl-C to stop"
  det "'+' appeared in that state, '-' left it; a move shows as both"

  watch_ocr_state
  watch_snapshot | sort > "$_ws_prev"
  # NOT 'grep -c . || echo 0': grep -c PRINTS the count and EXITS 1 when the
  # count is zero, so the fallback appends a second "0" and the result ("0\n0")
  # is not a number any more.
  # "have we seen activity" counts only what is IN FLIGHT. Documents already
  # filed are history, not activity -- counting them would make a watch started
  # against a pipeline with a full destination folder exit immediately.
  _seen="$(cancel_list 2>/dev/null | awk 'NF{n++} END{print n+0}')"
  [ "$_seen" -gt 0 ] && _ws_any=1 || _ws_any=""
  _ws_idle=0

  while :; do
    sleep "$WATCH_INTERVAL"
    watch_ocr_state
    watch_snapshot | sort > "$_ws_cur"
    if ! cmp -s "$_ws_prev" "$_ws_cur"; then
      _ts="$(date +%H:%M:%S)"
      comm -13 "$_ws_prev" "$_ws_cur" | while IFS="$TAB" read -r _st _f; do
        [ -n "$_f" ] && printf '  %s  + %-16s %s\n' "$_ts" "$_st" "${_f##*/}"
      done
      comm -23 "$_ws_prev" "$_ws_cur" | while IFS="$TAB" read -r _st _f; do
        [ -n "$_f" ] && printf '  %s  - %-16s %s\n' "$_ts" "$_st" "${_f##*/}"
      done
      cp "$_ws_cur" "$_ws_prev"
      _ws_any=1
    fi

    # drained = nothing in flight and my-ocr idle. Only ever exit if this run
    # actually saw something; started against an empty pipeline it waits.
    _inflight="$(cancel_list 2>/dev/null | awk 'NF{n++} END{print n+0}')"
    if [ -n "$_ws_any" ] && [ "$_inflight" -eq 0 ] && [ "$OCR_STATE" != "OCRing" ]; then
      _ws_idle=$(( _ws_idle + 1 ))
      if [ "$_ws_idle" -ge 2 ]; then
        echo
        msg "pipeline drained -- nothing in flight, my-ocr idle [0]"
        rm -f "$_ws_prev" "$_ws_cur"
        return 0
      fi
    else
      _ws_idle=0
    fi
  done
}

# "queued for OCR" only becomes "OCRing" when my-ocr says it is busy. Asking it
# costs a process, so ask only when there is something it could be working on.
watch_ocr_state() {
  OCR_STATE="queued for OCR"
  [ -d "$OCR_QUEUE_PATH" ] || return 0
  case "$(find "$OCR_QUEUE_PATH" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | head -n 1)" in
    "") return 0 ;;
  esac
  if [ -x "$MY_OCR" ] && "$MY_OCR" --status 2>/dev/null | grep -q "^OCR       BUSY"; then
    OCR_STATE="OCRing"
  fi
  return 0
}

do_status() {
  _pfx="$1"

  _p "${_pfx}CONFIG    $CONFIG_FILE (via $CONFIG_SOURCE)"
  _p "${_pfx}VERSION   $(do_version)"

  # drop folders, label and path in parallel lists
  _i=1
  for _dp in $DROP_PATHS; do
    _lbl="$(printf '%s\n' "$DROP_LABELS" | awk -v n="$_i" '{print $n}')"
    [ -z "$_lbl" ] && _lbl="drop$_i"
    _n="$(count_files "$_dp")"
    if [ "$_n" = "-" ]; then _p "${_pfx}DROP      $_lbl  $_dp  MISSING"
    else                     _p "${_pfx}DROP      $_lbl  $_dp  $_n waiting"; fi
    # -V answers the question you actually came with when a scan has not been
    # picked up: which of the three settle checks is it still failing?
    if [ "$VRB" = "1" ] && [ "$_n" != "-" ] && [ "$_n" != "0" ]; then
      settle_report "$_dp" "${_pfx}          "
    fi
    _i=$(( _i + 1 ))
  done

  # Ask my-ocr ONCE, before the queues are printed: whether it is busy decides
  # whether a queued file is in flight or stranded.
  OCR_STATUS=""; OCR_BUSY=0
  if [ -x "$MY_OCR" ]; then
    OCR_STATUS="$("$MY_OCR" --status 2>/dev/null)"
    case "$OCR_STATUS" in *"OCR       BUSY"*) OCR_BUSY=1 ;; esac
  fi

  # Nothing ever picks a file out of the OCR queue on its own: 'process' stages
  # from a drop folder and hands the batch straight to my-ocr. So a file left
  # here while my-ocr is idle is STRANDED, and saying so is the difference
  # between "wait" and "do something".
  _q2="$(count_files "$OCR_QUEUE_PATH")"
  _q2d="$(count_docs_pages "$OCR_QUEUE_PATH")"
  if [ "$_q2" = "0" ]; then
    _q2n="empty"
  elif [ "$OCR_BUSY" = "1" ]; then
    _q2n="$_q2d  being OCRed now -- they will clear on their own"
  else
    _q2n="$_q2d  STRANDED: nothing will pick these up ('$US process --retry')"
  fi
  _p "${_pfx}QUEUE     2ocr  $OCR_QUEUE_PATH  $_q2n"
  queue_detail "$OCR_QUEUE_PATH" "$_pfx"
  _qf="$(count_files "$T_PATH_FAILED")"
  if [ "$_qf" = "0" ]; then
    _p "${_pfx}QUEUE     fail  $T_PATH_FAILED  empty"
  else
    _p "${_pfx}QUEUE     fail  $T_PATH_FAILED  $(count_docs_pages "$T_PATH_FAILED")  my-ocr could not OCR these ('$US process --retry failed')"
    queue_detail "$T_PATH_FAILED" "$_pfx"
  fi
  if [ "$VRB" = "1" ]; then
    _p "${_pfx}QUEUE     done  $T_PATH_DONE  $(count_docs_pages "$T_PATH_DONE")"
    queue_detail "$T_PATH_DONE" "$_pfx"
  fi

  _p "${_pfx}FOLDERACTION $(folder_action_state)"
  [ "$VRB" = "1" ] && _p "${_pfx}          workflow: $WORKFLOW_DIR/$WORKFLOW_NAME$( [ -d "$WORKFLOW_DIR/$WORKFLOW_NAME" ] && echo " (present)" || echo " (MISSING)" )"

  # my-ocr knows what my-scan can only infer: whether the mutex is held and by
  # whom, and what is still queued. One line always -- "is the OCR busy" is the
  # actionable fact and the reason to run status at all -- the rest under -V.
  if [ -x "$MY_OCR" ]; then
    _os="$OCR_STATUS"
    if [ -n "$_os" ]; then
      _p "${_pfx}MY-OCR    $(printf '%s' "$_os" | sed -n 's/^OCR  *//p' | head -1)"
      if [ "$VRB" = "1" ]; then
        "$MY_OCR" -V --status 2>/dev/null | sed -e "s/^/${_pfx}          /"
      fi
    else
      _p "${_pfx}MY-OCR    '$MY_OCR' gave no status"
    fi
  else
    _p "${_pfx}MY-OCR    NOT FOUND at '$MY_OCR' -- my-scan cannot OCR anything"
  fi

  # OCR app
  if pgrep "$OCRAPP_NAME" >/dev/null 2>&1; then
    _p "${_pfx}OCRAPP    $OCRAPP_NAME running (pid(s) $(pgrep "$OCRAPP_NAME" | xargs echo))"
  else
    if [ -d "$OCRAPP_PATH" ]; then
      _p "${_pfx}OCRAPP    $OCRAPP_NAME not running ($OCRAPP_PATH)"
    else
      _p "${_pfx}OCRAPP    $OCRAPP_NAME NOT INSTALLED at '$OCRAPP_PATH' -- OCR cannot run here"
    fi
  fi

  _rp="$(running_pids)"
  # A bare list of pids explains nothing. Say what each one is doing.
  if [ -z "$_rp" ]; then
    _p "${_pfx}RUNNING   <none>"
  else
    _rpn=0
    for _rpp in $_rp; do
      _rpn=$(( _rpn + 1 ))
      _rpw="$(ps -o command= -p "$_rpp" 2>/dev/null | sed -e "s|.*$US ||" -e 's/  */ /g' | cut -c1-46)"
      case "$_rpw" in "") _rpw="(gone)";; esac
      _p "${_pfx}RUNNING   $_rpp  $US $_rpw"
    done
    [ "$_rpn" -gt 1 ] && \
      _p "${_pfx}          (one 'process' run is my-scan itself plus the my-ocr it is waiting on)"
  fi

  # LAST, deliberately: this is the only line that costs time -- reaching a
  # scanner that is usually off takes the full ping timeout. Everything about
  # the pipeline is already on screen before we go and wait for it.
  _host="$(scan_device_host)"
  if [ -n "$_host" ]; then
    if ping -c1 -t2 "$_host" >/dev/null 2>&1; then
      _reach="reachable [0]"
    else
      _rc=$?
      # a scanner that is meant to be off should not read as a fault
      if [ -n "$SCAN_DEVICE_USUALLY_OFF" ]; then
        _reach="not answering (normally off) [$_rc]"
      else
        _reach="UNREACHABLE [$_rc]"
      fi
    fi
  else
    _reach="no address in SCAN_DEVICE -- it needs one; a Bonjour name is not enough"
  fi
  _p "${_pfx}SCANNER   $SCAN_DEVICE_NAME ($SCAN_DEVICE)  $_reach"
  [ "$VRB" = "1" ] && _p "${_pfx}          backend: $(scan_backend)"

  return 0
}

# ---------------------------------------------------------------- cancel
# DOCUMENTS. A person reaching for "cancel" is thinking about a scan, not
# about a lockfile -- the plumbing is a consequence and is only shown with -V.
# Nothing is ever deleted: the worst that happens to a document is a move to
# T_PATH_FAILED, where status will show it.
cancel_list() { # writes "state<TAB>path" lines
  _i=1
  for _dp in $DROP_PATHS; do
    [ -d "$_dp" ] || continue
    candidate_files "$_dp" | while IFS= read -r _f; do
      [ -n "$_f" ] && printf 'arriving\t%s\n' "$_f"
    done
  done
  [ -d "$OCR_QUEUE_PATH" ] && find "$OCR_QUEUE_PATH" -mindepth 1 -maxdepth 1 -type f 2>/dev/null \
    | while IFS= read -r _f; do
        [ -n "$_f" ] && printf '%s\t%s\n' "$OCR_STATE" "$_f"
      done
  return 0
}

do_cancel() {
  # is my-ocr working right now? that is what turns "queued" into "OCRing"
  OCR_STATE="queued for OCR"
  if [ -x "$MY_OCR" ] && "$MY_OCR" --status 2>/dev/null | grep -q "^OCR       BUSY"; then
    OCR_STATE="OCRing"
  fi

  _tmp="$(mktemp /tmp/my-scan.cancel.XXXXXX)" || err 071 "mktemp failed."
  cancel_list > "$_tmp"
  _n="$(awk 'NF{n++} END{print n+0}' "$_tmp" 2>/dev/null)"

  if [ "$_n" -eq 0 ]; then
    msg "Nothing is in flight -- nothing to cancel."
    det "(documents already filed in '$T_PATH_DONE' are finished work, not pipeline state)"
    rm -f "$_tmp"; return 0
  fi

  # always LIST first: the destructive form is never what you get by accident
  msg "$_n document(s) in flight"
  printf '  %-3s %-46s %-16s\n' "ID" "DOCUMENT" "STATE"
  _i=0
  while IFS="$TAB" read -r _st _f; do
    [ -z "$_f" ] && continue
    _i=$(( _i + 1 ))
    printf '  %-3s %-46s %-16s\n' "$_i" "$(printf '%.46s' "${_f##*/}")" "$_st"
    [ "$VRB" = "1" ] && _p "      $_f"
  done < "$_tmp"

  if [ -z "$CANCEL_ALL" ] && [ $# -eq 0 ]; then
    echo
    det "nothing cancelled -- '$US cancel <ID>...' or '$US cancel --all'"
    rm -f "$_tmp"; return 0
  fi

  # --all can stop work you have not looked at, so it asks -- and with no
  # terminal to ask, it refuses rather than guessing.
  if [ -n "$CANCEL_ALL" ] && [ -z "$ASSUME_YES" ]; then
    if [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; then
      printf '  Cancel all %s document(s)? [y/N] ' "$_n"
      read -r _ans </dev/tty 2>/dev/null || _ans=""
      case "$_ans" in y|Y|yes|YES) ;; *) det "aborted."; rm -f "$_tmp"; return 0;; esac
    else
      rm -f "$_tmp"
      err 072 "'--all' needs confirmation and there is no terminal to ask. Add --yes."
    fi
  fi

  mkdir -p "$T_PATH_FAILED" 2>/dev/null
  _done=0
  _i=0
  while IFS="$TAB" read -r _st _f; do
    [ -z "$_f" ] && continue
    _i=$(( _i + 1 ))
    if [ -z "$CANCEL_ALL" ]; then
      _want=""
      for _id in "$@"; do [ "$_id" = "$_i" ] && _want=1; done
      [ -z "$_want" ] && continue
    fi
    [ -e "$_f" ] || continue
    _t="$T_PATH_FAILED/${_f##*/}"
    [ -e "$_t" ] && _t="$T_PATH_FAILED/$(date +%Y-%m-%d_%H%M.%S)___${_f##*/}"
    if mv "$_f" "$_t"; then
      _done=$(( _done + 1 ))
      msg2 "cancelled: '${_f##*/}' -> '$T_PATH_FAILED/'"
      [ "$_st" = "OCRing" ] && det "its OCR is still running -- '$US reset' stops the machinery"
    else
      err 073 "FAILED [$?] to move '$_f' to '$T_PATH_FAILED/'" "-"
    fi
  done < "$_tmp"
  rm -f "$_tmp"
  msg "cancelled $_done document(s) [0]"
  det "nothing was deleted -- they are in '$T_PATH_FAILED'"
  return 0
}

# ----------------------------------------------------------------- reset
# MACHINERY. Stale state that stops the pipeline running. It NEVER touches a
# document -- that promise is what makes it safe to run when you have no idea
# what is wrong, and it is the last thing the output says.
do_reset() {
  _found=0

  _rp="$(running_pids)"
  if [ -n "$_rp" ]; then
    _found=$(( _found + 1 ))
    msg2 "other $US process(es): $_rp"
    if [ -n "$RESET_ALL" ] && [ -z "$DRY_RUN" ]; then
      # shellcheck disable=SC2086  # a deliberate list of pids
      kill $_rp 2>/dev/null && det "killed"
    else
      det "would kill them"
    fi
  fi

  # my-ocr owns its own machinery, so it is the one that knows how to clean it.
  # Hand the job over rather than reaching into its state from here.
  if [ -x "$MY_OCR" ]; then
    _os="$("$MY_OCR" --status 2>/dev/null)"
    case "$_os" in
      *"BUSY"*)
        _found=$(( _found + 1 ))
        msg2 "an OCR is running:"
        printf '%s\n' "$_os" | grep "BUSY" | sed -e 's/^/    > /'
        det "leave it unless it is wedged -- my-ocr alerts by itself when it stalls"
        det "(my-ocr reset refuses while a run is live, so it is not called here)" ;;
      *)
        msg2 "my-ocr machinery"
        if [ -n "$RESET_ALL" ] && [ -z "$DRY_RUN" ]; then
          "$MY_OCR" reset go 2>&1 | sed -e 's/^/    | /'
        else
          "$MY_OCR" reset    2>&1 | sed -e 's/^/    | /'
        fi
        det "^ my-ocr's own reset: stale mutex, leftovers from runs that are gone,"
        det "  and any document stranded mid-flight moved where it can be retried" ;;
    esac
  fi

  if [ "$_found" -eq 0 ]; then
    msg "Machinery is clean -- nothing to reset."
  elif [ -z "$RESET_ALL" ]; then
    echo
    det "nothing changed -- '$US reset --all' to act on the above"
  fi
  echo
  det "no documents are touched by reset -- use '$US cancel' for those"
  return 0
}


##############################################################################
#### WATCH -- the OCR deblock watchdog (was: ___wait-for-ocr)
##
## Automator only advances to the OCR step once part-1's shell action has
## exited, so part-1 cannot wait for the OCR itself. This runs in the
## background instead: if the OCR never finishes, it removes the stale lock
## and fails the file out, so the NEXT scan is not blocked for the full
## LOCKFILE_TIMEOUT. It does not duplicate part-2 -- it calls it.




##############################################################################
#### SETUP -- wire the Folder Action + Automator workflow for the GUI user

automator_app() {
  for _c in /System/Applications/Automator.app /Applications/Automator.app; do
    [ -d "$_c" ] && { _p "$_c"; return 0; }
  done
  _p ""
  return 1
}

setup_preflight() {
  _fail=0
  msg2 "Preflight -- everything the Folder Action will need at scan time"

  _a="$(automator_app)"
  if [ -n "$_a" ]; then det "Automator      OK   $_a"
  else                  det "Automator      MISSING -- reinstall it from the macOS installer"; _fail=1; fi

  if [ -d "$OCRAPP_PATH" ]; then det "$OCRAPP_NAME     OK   $OCRAPP_PATH"
  else det "$OCRAPP_NAME     MISSING at '$OCRAPP_PATH' -- OCR cannot run"; _fail=1; fi

  _act="$OCRAPP_PATH/Contents/Library/Automator/ExportToPdf.action"
  if [ -d "$_act" ]; then det "OCR action     OK   $_act"
  else det "OCR action     MISSING at '$_act' -- the workflow's OCR step will not load"; _fail=1; fi

  for _c in "$c_trash" "$c_convert" "$c_pdfinfo" "$c_qpdf" "$c_lsof"; do
    if [ -x "$_c" ]; then det "$(printf '%-14s' "${_c##*/}") OK   $_c"
    else det "$(printf '%-14s' "${_c##*/}") MISSING at '$_c'"; _fail=1; fi
  done

  if [ -x "$WORKFLOW_MY_SCAN" ]; then det "my-scan        OK   $WORKFLOW_MY_SCAN"
  else det "my-scan        NOT EXECUTABLE at '$WORKFLOW_MY_SCAN' -- the workflow calls that path"; _fail=1; fi

  if [ "$_fail" = "0" ]; then det "preflight PASSED [0]"; else det "preflight FAILED [$_fail]"; fi
  return $_fail
}

setup_dirs() {
  msg2 "Directories named by the config"
  _fail=0
  # DROP_PATHS is a space-separated list; one directory per line from here on
  _dirs=""
  for _dp in $DROP_PATHS; do _dirs="$_dirs$_dp
"; done
  _dirs="$_dirs$OCR_QUEUE_PATH
$PART2_S_PATH
$PART2_T_PATH
$T_PATH_DONE
$T_PATH_FAILED
$LOCKFILE_PATH
$WORKFLOW_DIR"
  [ -n "$LOG" ] && _dirs="$_dirs
${LOG%/*}"
  [ -n "$SETTLE_BACKUP_PATH" ] && _dirs="$_dirs
$SETTLE_BACKUP_PATH"

  _seen=""
  while IFS= read -r _d; do
    [ -z "$_d" ] && continue
    case "$_seen" in *"|$_d|"*) continue ;; esac
    _seen="$_seen|$_d|"

    if [ -d "$_d" ]; then
      if [ -w "$_d" ]; then det "OK       $_d"
      else det "NOT WRITABLE by $(id -un): $_d  (owner $(/usr/bin/stat -f '%Su:%Sg mode %Lp' "$_d"))"; _fail=1; fi
    elif [ -n "$DRY_RUN" ]; then
      det "WOULD CREATE  $_d"
    else
      if mkdir -p "$_d" 2>/dev/null; then det "CREATED  $_d"
      else det "CANNOT CREATE $_d -- its parent is not writable by $(id -un)"; _fail=1; fi
    fi
  done <<_EOSD_
$_dirs
_EOSD_
  return $_fail
}

# The Automator document. Three steps, exactly as the hand-built workflow on
# the live machine: shell -> OCR -> shell. The shell steps call THIS tool, so
# the settle/validate logic lives in the repo instead of inside the workflow.
setup_write_workflow() {
  _wf="$WORKFLOW_DIR/$WORKFLOW_NAME"
  msg2 "Automator workflow '$_wf'"

  # A config written before WORKFLOW_SHELL existed leaves it empty, which would
  # write a workflow with no shell -- and Automator runs those silently, doing
  # nothing at all. Fall back, and refuse a shell Automator does not offer.
  [ -n "$WORKFLOW_SHELL" ] || WORKFLOW_SHELL="/bin/zsh"
  case "$WORKFLOW_SHELL" in
    /bin/bash|/bin/csh|/bin/ksh|/bin/sh|/bin/tcsh|/bin/zsh) ;;
    /usr/bin/perl|/usr/bin/ruby|/usr/local/bin/python|/usr/local/bin/python3) ;;
    *) err 063 "WORKFLOW_SHELL '$WORKFLOW_SHELL' is not one Automator accepts. \
Its Run Shell Script step silently does nothing with any other shell -- no error, \
nothing in any log. Use one of: /bin/zsh /bin/sh /bin/bash /bin/ksh /bin/csh /bin/tcsh." "-"
       return 1 ;;
  esac

  if [ -d "$_wf" ]; then
    _bak="$_wf.bak-$(date -u +%Y%m%dT%H%M%SZ)"
    if [ -n "$DRY_RUN" ]; then det "WOULD BACK UP the existing workflow to '$_bak'"
    else run cp -R "$_wf" "$_bak" || { err 059 "FAILED to back up '$_wf'" "-"; return 1; }
         det "backed the existing workflow up to '$_bak'"; fi
  fi

  # keep the backup pile bounded; one accumulates per 'setup go' otherwise
  if [ -z "$DRY_RUN" ]; then
    _keep="$WORKFLOW_BACKUPS_KEEP"; isInt "$_keep" || _keep=3
    find "$WORKFLOW_DIR" -maxdepth 1 -type d -name "$WORKFLOW_NAME.bak-*" 2>/dev/null \
      | sort -r | tail -n +$(( _keep + 1 )) \
      | while IFS= read -r _ob; do
          [ -n "$_ob" ] && rm -rf "$_ob" && det "pruned old backup '${_ob##*/}'"
        done
  fi

  if [ -n "$DRY_RUN" ]; then
    det "WOULD WRITE a ONE-step workflow: $WORKFLOW_MY_SCAN process"
    det "  my-ocr does the OCR and has its own Folder Action, so Automator"
    det "  no longer has to drive $OCRAPP_NAME across two shell steps."
    return 0
  fi

  mkdir -p "$_wf/Contents" || { err 060 "FAILED to create '$_wf/Contents'" "-"; return 1; }

  cat >"$_wf/Contents/Info.plist" <<_EOIP_
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMFolderAction</key>
	<string>AMAddingFolderItems</string>
</dict>
</plist>
_EOIP_

  _doc="$_wf/Contents/document.wflow"
  _gerr="$(mktemp /tmp/my-scan.wflow.XXXXXX)" || return 1
  # The workflow records WHICH folder it serves; one workflow per drop path is
  # not supported here, so the first is the one it is written for.
  _dp1=""; for _d in $DROP_PATHS; do _dp1="$_d"; break; done
  MY_SCAN_BIN="$WORKFLOW_MY_SCAN" \
  MY_SCAN_DROP="$_dp1" \
  MY_SCAN_SHELL="$WORKFLOW_SHELL" \
  /usr/bin/python3 - "$_doc" 2>"$_gerr" <<'_EOPY_'
import os, plistlib, sys, uuid

BIN    = os.environ["MY_SCAN_BIN"]
DROP   = os.environ["MY_SCAN_DROP"]
SHELL_ = os.environ["MY_SCAN_SHELL"]

def shell(cmd, uid):
    return {"action": {
        "AMAccepts": {"Container": "List", "Optional": False, "Types": ["com.apple.cocoa.string"]},
        "AMActionVersion": "2.0.3",
        "AMApplication": ["Automator"],
        "AMParameterProperties": {
            "COMMAND_STRING": {}, "CheckedForUserDefaultShell": {},
            "inputMethod": {}, "shell": {}, "source": {}},
        "AMProvides": {"Container": "List", "Types": ["com.apple.cocoa.string"]},
